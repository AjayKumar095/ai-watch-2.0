PORT=3000
DB_DIALECT=sqlite
DB_STORAGE=./dev.sqlite3
SQL_LOGGING=false
JWT_ACCESS_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SESSION_SECRET=REPLACE_ME
NODE_ENV=development

# --- Mailer plugin (src/plugins/mailer) ---
# Uses Gmail + an App Password by default (myaccount.google.com/apppasswords —
# requires 2-Step Verification on the account). Point MAIL_USER/MAIL_APP_PASSWORD
# at a real Gmail account to actually send; leave blank and the plugin just
# logs what it would have sent instead of throwing.
MAIL_SERVICE=gmail
MAIL_USER=REPLACE_ME@gmail.com
MAIL_APP_PASSWORD=REPLACE_ME
MAIL_FROM_NAME=AI-Watch
# Only needed for a non-Gmail SMTP provider — leave unset to use MAIL_SERVICE above.
# MAIL_HOST=
# MAIL_PORT=587
