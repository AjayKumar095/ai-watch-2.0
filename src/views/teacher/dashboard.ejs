<div class="mb-6 flex items-center gap-3">

  <div>
    <h1 class="text-2xl font-bold text-navy-900">Welcome back, <%= currentUser.firstName %></h1>
    <p class="text-sm text-navy-500"><%= teacherProfile.designation || 'Teacher' %> · Employee code <%= teacherProfile.employeeCode %></p>
  </div>
</div>

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <div class="stat-card group">
    <span class="stat-accent bg-sky-500"></span>
    <div class="stat-icon bg-sky-50 text-sky-600"><i class="fa-solid fa-layer-group"></i></div>
    <div>
      <p class="stat-value"><%= mappings.length %></p>
      <p class="stat-label">My Subject Mappings</p>
      <a class="stat-link"  href="/teacher/roster" >
        View my roster
        <i class="fa-solid fa-arrow-right ml-1 inline-block -translate-x-0.5 transition-all group-hover:translate-x-0"></i>
      </a>
    </div>
  </div>

  <div class="stat-card">
    <span class="stat-accent bg-violet-500"></span>
    <div class="stat-icon bg-violet-50 text-violet-600"><i class="fa-solid fa-file-pen"></i></div>
    <div>
      <p class="stat-value"><%= assessmentCount %></p>
      <p class="stat-label">Assessments Created</p>
    </div>
  </div>

  <div class="stat-card">
    <span class="stat-accent bg-amber-500"></span>
    <div class="stat-icon bg-amber-50 text-amber-600"><i class="fa-solid fa-hourglass-half"></i></div>
    <div>
      <p class="stat-value text-amber-600"><%= pendingEvalCount %></p>
      <p class="stat-label">Ungraded Submissions</p>
    </div>
  </div>

  <div class="stat-card group">
    <span class="stat-accent bg-info-500"></span>
    <div class="stat-icon bg-info-50 text-info-600"><i class="fa-solid fa-user-clock"></i></div>
    <div>
      <p class="stat-value text-info-600"><%= pendingApprovals.length %></p>
      <p class="stat-label">Pending Approvals</p>
      <% if (pendingApprovals.length) { %>
        <p class="stat-link text-info-600">
          Requires your action
          <i class="fa-solid fa-arrow-right ml-1 inline-block -translate-x-0.5 transition-all group-hover:translate-x-0"></i>
        </p>
      <% } else { %>
        <p class="stat-link text-navy-300">All caught up</p>
      <% } %>
    </div>
  </div>
</div>

<div id="pending-approvals" class="card mt-6 scroll-mt-6">
  <div class="mb-4 flex items-center justify-between">
    <h2 class="text-lg font-semibold text-navy-900">Pending Student Approvals</h2>
    <% if (pendingApprovals.length) { %>
      <span class="badge-amber"><%= pendingApprovals.length %> waiting</span>
    <% } %>
  </div>

  <% if (!pendingApprovals.length) { %>
    <div class="flex flex-col items-center justify-center gap-2 py-10 text-center">
      <div class="flex h-11 w-11 items-center justify-center rounded-full bg-teal-50 text-teal-600">
        <i class="fa-solid fa-check"></i>
      </div>
      <p class="text-sm text-navy-400">No pending approval requests right now.</p>
    </div>
  <% } else { %>
    <form action="/teacher/approvals/bulk-approve" method="POST">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-navy-100 text-sm">
          <thead>
            <tr class="text-left text-xs font-medium uppercase tracking-wide text-navy-400">
              <th class="py-2 pr-3">
                <input
                  class="h-4 w-4 rounded border-navy-300 text-info-600 focus:ring-info-500"
                  type="checkbox"
                  onclick="document.querySelectorAll('.req-check').forEach(c=>c.checked=this.checked)"
                />
              </th>
              <th class="py-2 pr-3">Student</th>
              <th class="py-2 pr-3">Roll No</th>
              <th class="py-2 pr-3">Program</th>
              <th class="py-2 pr-3">Requested</th>
              <th class="py-2 pr-3">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-navy-50">
            <% pendingApprovals.forEach(function(req) { %>
              <tr class="transition-colors hover:bg-navy-50/60">
                <td class="py-2.5 pr-3">
                  <input class="req-check h-4 w-4 rounded border-navy-300 text-info-600 focus:ring-info-500" type="checkbox" name="requestIds" value="<%= req.id %>" />
                </td>
                <td class="py-2.5 pr-3">
                  <div class="flex items-center gap-2.5">
                    <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-navy-100 text-[11px] font-semibold text-navy-600">
                      <%= req.StudentProfile.User.firstName.charAt(0).toUpperCase() %>
                    </div>
                    <span class="font-medium text-navy-800"><%= req.StudentProfile.User.firstName %> <%= req.StudentProfile.User.lastName %></span>
                  </div>
                </td>
                <td class="py-2.5 pr-3 text-navy-500"><%= req.StudentProfile.rollNo %></td>
                <td class="py-2.5 pr-3 text-navy-500"><%= req.StudentProfile.Program ? req.StudentProfile.Program.name : '—' %></td>
                <td class="py-2.5 pr-3 text-navy-400"><%= new Date(req.createdAt).toLocaleDateString() %></td>
                <td class="py-2.5 pr-3">
                  <div class="flex gap-2">
                    <button formaction="/teacher/approvals/<%= req.id %>/approve" formmethod="POST" class="btn-primary !px-3 !py-1 text-xs">Approve</button>
                    <button formaction="/teacher/approvals/<%= req.id %>/reject" formmethod="POST" class="btn-secondary !px-3 !py-1 text-xs">Reject</button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <button type="submit" class="btn-primary mt-4">Approve selected</button>
    </form>
  <% } %>
</div>

<style>
  .stat-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    min-height: 9.5rem;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid rgb(241 245 249);
    background: #fff;
    padding: 1.1rem 1.1rem 1rem;
    transition: box-shadow 0.18s ease, transform 0.18s ease, border-color 0.18s ease;
  }
  .stat-card:hover {
    box-shadow: 0 12px 24px -8px rgba(32, 58, 99, 0.16);
    border-color: rgb(226 232 240);
    transform: translateY(-2px);
  }
  .stat-card:hover .stat-icon {
    transform: scale(1.06);
  }
  .stat-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    border-top-left-radius: 1rem;
    border-top-right-radius: 1rem;
  }
  .stat-icon {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    font-size: 1.05rem;
    box-shadow: inset 0 0 0 1px rgba(15, 23, 42, 0.03);
    transition: transform 0.18s ease;
  }
  .stat-value {
    font-size: 1.75rem;
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: #203A63;
  }
  .stat-label {
    margin-top: 0.25rem;
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #94A3B8;
  }
  .stat-link {
    margin-top: 0.5rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #2E90FA;
  }
</style>
