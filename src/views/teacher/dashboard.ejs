<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-navy-900">Welcome back, <%= currentUser.firstName %></h1>
    <p class="text-sm text-navy-500"><%= teacherProfile.designation || 'Teacher' %> · Employee code <%= teacherProfile.employeeCode %></p>
  </div>
</div>

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <div class="card">
    <p class="text-xs font-medium uppercase tracking-wide text-navy-400">My Subject Mappings</p>
    <p class="mt-2 text-3xl font-bold text-navy-900"><%= mappings.length %></p>
    <a href="/teacher/roster" class="mt-3 inline-block text-sm font-medium text-info-600 hover:text-info-700">View my roster →</a>
  </div>
  <div class="card">
    <p class="text-xs font-medium uppercase tracking-wide text-navy-400">Assessments Created</p>
    <p class="mt-2 text-3xl font-bold text-navy-900"><%= assessmentCount %></p>
    <span class="badge-navy mt-3">Create / duplicate — coming next</span>
  </div>
  <div class="card">
    <p class="text-xs font-medium uppercase tracking-wide text-navy-400">Ungraded Submissions</p>
    <p class="mt-2 text-3xl font-bold text-amber-600"><%= pendingEvalCount %></p>
    <span class="badge-amber mt-3">Bulk evaluate — coming next</span>
  </div>
  <div class="card">
    <p class="text-xs font-medium uppercase tracking-wide text-navy-400">Pending Approvals</p>
    <p class="mt-2 text-3xl font-bold text-info-600"><%= pendingApprovals.length %></p>
    <span class="badge-info mt-3">Requires your action</span>
  </div>
</div>

<div class="card mt-6">
  <div class="mb-4 flex items-center justify-between">
    <h2 class="text-lg font-semibold text-navy-900">Pending Student Approvals</h2>
    <% if (pendingApprovals.length) { %>
      <span class="badge-amber"><%= pendingApprovals.length %> waiting</span>
    <% } %>
  </div>

  <% if (!pendingApprovals.length) { %>
    <p class="text-sm text-navy-400">No pending approval requests right now.</p>
  <% } else { %>
    <form action="/teacher/approvals/bulk-approve" method="POST">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-navy-100 text-sm">
          <thead>
            <tr class="text-left text-xs font-medium uppercase tracking-wide text-navy-400">
              <th class="py-2 pr-3"><input type="checkbox" onclick="document.querySelectorAll('.req-check').forEach(c=>c.checked=this.checked)" /></th>
              <th class="py-2 pr-3">Student</th>
              <th class="py-2 pr-3">Roll No</th>
              <th class="py-2 pr-3">Program</th>
              <th class="py-2 pr-3">Requested</th>
              <th class="py-2 pr-3">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-navy-50">
            <% pendingApprovals.forEach(function(req) { %>
              <tr>
                <td class="py-2 pr-3"><input class="req-check" type="checkbox" name="requestIds" value="<%= req.id %>" /></td>
                <td class="py-2 pr-3 font-medium text-navy-800"><%= req.StudentProfile.User.firstName %> <%= req.StudentProfile.User.lastName %></td>
                <td class="py-2 pr-3 text-navy-500"><%= req.StudentProfile.rollNo %></td>
                <td class="py-2 pr-3 text-navy-500"><%= req.StudentProfile.Program ? req.StudentProfile.Program.name : '—' %></td>
                <td class="py-2 pr-3 text-navy-400"><%= new Date(req.createdAt).toLocaleDateString() %></td>
                <td class="py-2 pr-3">
                  <div class="flex gap-2">
                    <button formaction="/teacher/approvals/<%= req.id %>/approve" formmethod="POST" class="btn-primary !px-3 !py-1 text-xs">Approve</button>
                    <button formaction="/teacher/approvals/<%= req.id %>/reject" formmethod="POST" class="btn-secondary !px-3 !py-1 text-xs">Reject</button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <button type="submit" class="btn-primary mt-4">Approve selected</button>
    </form>
  <% } %>
</div>
