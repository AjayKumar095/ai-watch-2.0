<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold text-navy-900">My Assessments</h1>
  <a href="/teacher/assessments/new" class="btn-primary whitespace-nowrap">
    <i class="fa-solid fa-plus mr-1.5"></i>Create Assessment
  </a>
</div>

<% if (!assessments.length) { %>
  <div class="card flex flex-col items-center gap-2 py-12 text-center text-sm text-navy-400">
    <i class="fa-regular fa-folder-open text-3xl text-navy-200"></i>
    No assessments yet.
  </div>
<% } %>

<div class="space-y-4">
  <% assessments.forEach(function(a) { const c = counts[a.id]; %>
    <div class="card transition-shadow hover:shadow-md">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0">
          <h2 class="truncate font-semibold text-navy-900"><%= a.title %></h2>
          <p class="mt-0.5 text-xs text-navy-400">
            <%= a.SubjectOffering.SubjectPool.name %> · <%= a.SubjectOffering.Program.name %> Sem <%= a.SubjectOffering.semesterNumber %>
            · <%= a.AssessmentSections.length %> section(s) · Due <%= new Date(a.endAt).toLocaleDateString() %>
          </p>
        </div>
        <div class="flex shrink-0 items-center gap-2">
          <span class="badge-amber whitespace-nowrap"><%= c.pending %> pending</span>
          <span class="badge-info whitespace-nowrap"><%= c.total %> total</span>
        </div>
      </div>

      <div class="mt-3 flex flex-wrap items-center gap-2 border-t border-navy-100 pt-3">
        <a href="/teacher/assessments/<%= a.id %>/submissions" class="btn-secondary !px-3 !py-1.5 text-xs whitespace-nowrap">
          <i class="fa-solid fa-inbox mr-1"></i>View submissions
        </a>
        <a href="/teacher/assessments/<%= a.id %>/override" class="btn-ghost text-xs whitespace-nowrap">
          <i class="fa-solid fa-door-open mr-1"></i>Open for students
        </a>
        <a href="/teacher/assessments/<%= a.id %>/edit" class="btn-ghost text-xs whitespace-nowrap">
          <i class="fa-solid fa-pen mr-1"></i>Edit
        </a>
        <a href="/teacher/assessments/new?duplicateFrom=<%= a.id %>" class="btn-ghost text-xs whitespace-nowrap">
          <i class="fa-regular fa-copy mr-1"></i>Duplicate
        </a>
        <form action="/teacher/assessments/<%= a.id %>/delete" method="POST" class="delete-assessment-form ml-auto" data-title="<%= a.title %>" data-total="<%= c.total %>">
          <button type="submit" class="btn-ghost text-xs !text-amber-700 whitespace-nowrap">
            <i class="fa-regular fa-trash-can mr-1"></i>Delete
          </button>
        </form>
      </div>
    </div>
  <% }) %>
</div>

<script>
  document.querySelectorAll('.delete-assessment-form').forEach(function (form) {
    form.addEventListener('submit', function (e) {
      var title = form.dataset.title;
      var total = form.dataset.total;
      var message = 'Delete "' + title + '"? This also permanently deletes all ' + total +
        ' student submission(s) for it, any files they uploaded, and per-student submission-window exceptions. This cannot be undone.';
      if (!confirm(message)) {
        e.preventDefault();
      }
    });
  });
</script>
