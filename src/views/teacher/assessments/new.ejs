<div class="mx-auto mt-4 max-w-2xl">
  <div class="card">
    <h1 class="text-xl font-bold text-navy-900">Create Assessment</h1>
    <p class="mt-1 text-sm text-navy-500">
      Select exactly the sections you're targeting — across one subject or several programs at once
      (global subjects), all in one assessment.
    </p>

    <% if (error) { %>
      <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= error %></div>
    <% } %>

    <form id="assessment-form" action="/teacher/assessments/new" method="POST" class="mt-6 space-y-4">
      <div>
        <label class="form-label">Title</label>
        <input class="form-input" name="title" value="<%= formData.title || '' %>" required />
      </div>
      <div>
        <label class="form-label">Description</label>
        <div id="assessment-editor" class="rounded-lg border border-navy-200"></div>
        <input type="hidden" id="descriptionBlocks" name="descriptionBlocks" />
      </div>
      <div>
        <label class="form-label">Attachment URL (optional)</label>
        <input class="form-input" name="attachmentUrl" value="<%= formData.attachmentUrl || '' %>" />
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div>
          <label class="form-label">Opens</label>
          <input class="form-input" type="datetime-local" name="startAt" required />
        </div>
        <div>
          <label class="form-label">Closes</label>
          <input class="form-input" type="datetime-local" name="endAt" required />
        </div>
        <div>
          <label class="form-label">Max marks</label>
          <input class="form-input" type="number" step="0.5" name="maxMarks" value="<%= formData.maxMarks || '' %>" required />
        </div>
      </div>

      <div>
        <label class="form-label">Target sections</label>
        <% if (!targetOptions.length) { %>
          <p class="text-sm text-navy-400">You have no subject mappings yet — ask the admin to map you to a subject.</p>
        <% } %>
        <div class="max-h-64 space-y-1 overflow-y-auto rounded-lg border border-navy-100 p-3">
          <% targetOptions.forEach(function(opt) { %>
            <label class="flex items-center gap-2 rounded px-2 py-1 text-sm hover:bg-navy-50">
              <input type="checkbox" name="targets" value="<%= opt.subjectOfferingId %>:<%= opt.section.id %>" />
              <span class="font-medium text-navy-800"><%= opt.subjectOffering.SubjectPool.name %></span>
              <span class="text-navy-400">— <%= opt.subjectOffering.Program.name %> Sem <%= opt.subjectOffering.semesterNumber %> · Section <%= opt.section.name %></span>
            </label>
          <% }) %>
        </div>
      </div>

      <button type="submit" class="btn-primary w-full">Create assessment</button>
    </form>
  </div>
</div>

<link rel="stylesheet" href="/js/assessmentEditorEntry.css" />
<script src="/js/assessmentEditorEntry.js"></script>
<script>
  (function () {
    var initialContent = null;
    try {
      initialContent = JSON.parse(<%- JSON.stringify(initialDescriptionJson) %>);
    } catch (e) {
      initialContent = null;
    }
    var editorHandle = window.AssessmentEditorApp.mount("assessment-editor", initialContent);

    document.getElementById("assessment-form").addEventListener("submit", function () {
      document.getElementById("descriptionBlocks").value = JSON.stringify(editorHandle.getContent());
    });
  })();
</script>
