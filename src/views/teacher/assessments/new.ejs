<div class="mx-auto mt-2 max-w-5xl">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-navy-900">Create Assessment</h1>
    <p class="mt-1 text-sm text-navy-500">
      Select exactly the sections you're targeting — across one subject or several programs at once, all in one assessment.
    </p>
  </div>

  <% if (error) { %>
    <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= error %></div>
  <% } %>

  <form id="assessment-form" action="/teacher/assessments/new" method="POST" class="space-y-6">
    <!-- Details -->
    <div class="card">
      <h2 class="mb-4 flex items-center gap-2 text-sm font-semibold text-navy-900">
        <i class="fa-solid fa-circle-info text-info-500"></i> Details
      </h2>
      <div class="space-y-4">
        <div>
          <label class="form-label">Title</label>
          <input class="form-input" name="title" value="<%= formData.title || '' %>" required placeholder="e.g. Week 3 Quiz" />
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div>
            <label class="form-label">Opens</label>
            <input class="form-input" type="datetime-local" name="startAt" required />
          </div>
          <div>
            <label class="form-label">Closes</label>
            <input class="form-input" type="datetime-local" name="endAt" required />
          </div>
          <div>
            <label class="form-label">Max marks</label>
            <input class="form-input" type="number" step="0.5" name="maxMarks" value="<%= formData.maxMarks || '' %>" required placeholder="e.g. 10" />
          </div>
        </div>
        <div>
          <label class="form-label">Attachment URL (optional)</label>
          <input class="form-input" name="attachmentUrl" value="<%= formData.attachmentUrl || '' %>" placeholder="https://..." />
        </div>
      </div>
    </div>

    <!-- Content -->
    <div class="card">
      <h2 class="mb-4 flex items-center gap-2 text-sm font-semibold text-navy-900">
        <i class="fa-solid fa-file-lines text-info-500"></i> Assessment Content
      </h2>
      <div id="assessment-editor" class="editor-shell overflow-hidden rounded-lg border border-navy-200"></div>
      <input type="hidden" id="descriptionBlocks" name="descriptionBlocks" />
      <p class="mt-2 text-xs text-navy-400">Use "/" inside the editor for headings, lists, images, code blocks, and more.</p>
    </div>

    <!-- Target sections -->
    <div class="card">
      <div class="mb-3 flex items-center justify-between gap-4">
        <h2 class="flex items-center gap-2 text-sm font-semibold text-navy-900">
          <i class="fa-solid fa-bullseye text-info-500"></i> Target Sections
        </h2>
        <div class="flex items-center gap-3">
          <label class="flex items-center gap-1.5 text-xs text-navy-500">
            <input type="checkbox" id="select-all-targets" onclick="toggleAllTargets(this.checked)">
            Select all
          </label>
          <% if (targetOptions.length > 3) { %>
            <div class="relative w-64">
              <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-xs text-navy-400"></i>
              <input
                type="text"
                id="filter-targets"
                placeholder="Search sections or subjects..."
                class="form-input !py-1 !pl-8 text-xs w-full"
                oninput="filterTargetSections(this.value)"
              />
            </div>
          <% } %>
        </div>
      </div>
      <% if (!targetOptions.length) { %>
        <p class="text-sm text-navy-400">You have no subject mappings yet — ask the admin to map you to a subject.</p>
      <% } %>
      <div id="target-options-list" class="grid max-h-72 grid-cols-1 gap-2 overflow-y-auto rounded-lg border border-navy-100 p-3 sm:grid-cols-2">
        <% targetOptions.forEach(function(opt) { %>
          <label class="flex items-start gap-2 rounded-lg border border-transparent px-3 py-2 text-sm hover:border-navy-100 hover:bg-navy-50">
            <input
              type="checkbox"
              class="target-checkbox mt-0.5"
              name="targets"
              value="<%= opt.subjectOfferingId %>:<%= opt.section.id %>:<%= opt.specSignature %>"
            />
            <span>
              <span class="block font-medium text-navy-800">
                <%= opt.subjectOffering.SubjectPool.name %>
                <span class="font-normal text-navy-400">(<%= opt.subjectOffering.SubjectPool.code %>)</span>
              </span>
              <span class="text-xs text-navy-400">
                <%= opt.subjectOffering.Program.name %> · Sem <%= opt.subjectOffering.semesterNumber %> · <%= opt.sectionLabel %>
              </span>
              <span class="mt-0.5 block text-xs">
                <span class="<%= opt.specializationNames.length ? 'badge-navy' : 'badge-info' %>">
                  <%= opt.specializationNames.length ? opt.specializationNames.join(', ') : 'All specializations' %>
                </span>
              </span>
            </span>
          </label>
        <% }) %>
      </div>
    </div>

    <div class="flex justify-end">
      <button type="submit" class="btn-primary !px-8">Create assessment</button>
    </div>
  </form>
</div>

<link rel="stylesheet" href="/js/assessmentEditorEntry.css" />
<script src="/js/assessmentEditorEntry.js"></script>
<script>
  (function () {
    var initialContent = null;
    try {
      initialContent = JSON.parse(<%- JSON.stringify(initialDescriptionJson) %>);
    } catch (e) {
      initialContent = null;
    }
    var editorHandle = window.AssessmentEditorApp.mount("assessment-editor", initialContent);

    document.getElementById("assessment-form").addEventListener("submit", function () {
      document.getElementById("descriptionBlocks").value = JSON.stringify(editorHandle.getContent());
    });
  })();

  function filterTargetSections(query) {
    var q = (query || '').toLowerCase().trim();
    var labels = document.querySelectorAll('#target-options-list label');
    labels.forEach(function(l) {
      var text = l.textContent.toLowerCase();
      if (!q || text.includes(q)) {
        l.classList.remove('hidden');
      } else {
        l.classList.add('hidden');
      }
    });
    // Search changed which rows are visible — "Select all" no longer
    // reliably reflects the visible set, so reset it rather than leave a
    // stale checked state that doesn't match what's actually on screen.
    document.getElementById('select-all-targets').checked = false;
  }

  // Only toggles checkboxes belonging to currently VISIBLE (non-filtered-
  // out) rows — selecting "all" while a search is active shouldn't
  // silently also select the hidden ones the teacher can't currently see.
  function toggleAllTargets(checked) {
    var labels = document.querySelectorAll('#target-options-list label');
    labels.forEach(function(l) {
      if (l.classList.contains('hidden')) return;
      var checkbox = l.querySelector('.target-checkbox');
      if (checkbox) checkbox.checked = checked;
    });
  }
</script>
