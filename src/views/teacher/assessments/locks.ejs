<div class="mb-6">
  <h1 class="text-xl font-bold text-navy-900">Lock Assessments</h1>
  <p class="mt-1 text-sm text-navy-500">
    Once you're done setting assessments for a section, lock it here. Locking blocks new assessments
    for that section — it never affects existing submissions or evaluations, and it's the last gate
    before your students' certificates unlock.
  </p>
</div>

<% if (typeof status !== 'undefined' && status === 'locked') { %>
  <div class="mb-4 rounded-lg border border-info-200 bg-info-50 px-3 py-2 text-sm text-info-800">Section locked.</div>
<% } else if (typeof status !== 'undefined' && status === 'unlocked') { %>
  <div class="mb-4 rounded-lg border border-info-200 bg-info-50 px-3 py-2 text-sm text-info-800">Section unlocked.</div>
<% } %>
<% if (typeof error !== 'undefined' && error) { %>
  <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= error %></div>
<% } %>

<% if (!scopes.length) { %>
  <p class="text-sm text-navy-400">No submissions yet under any of your assessments — nothing to lock.</p>
<% } else { %>
  <div class="overflow-hidden rounded-xl border border-navy-100 bg-white">
    <table class="w-full text-sm">
      <thead class="bg-navy-50 text-left text-xs font-semibold uppercase tracking-wide text-navy-500">
        <tr>
          <th class="px-4 py-3">Subject Offering</th>
          <th class="px-4 py-3">Section</th>
          <th class="px-4 py-3">Status</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-navy-50">
        <% scopes.forEach(function(s) { %>
          <tr>
            <td class="px-4 py-3 font-medium text-navy-900">
              <%= s.subjectOffering && s.subjectOffering.SubjectPool ? s.subjectOffering.SubjectPool.name : s.subjectOfferingId %>
            </td>
            <td class="px-4 py-3 text-navy-600">
              <%= s.section ? s.section.name : s.sectionId %>
            </td>
            <td class="px-4 py-3">
              <% if (s.lock && s.lock.isLocked) { %>
                <span class="inline-flex items-center gap-1 rounded-full bg-teal-50 px-2 py-1 text-xs font-medium text-teal-700">
                  <i class="fa-solid fa-lock"></i> Locked
                </span>
              <% } else { %>
                <span class="inline-flex items-center gap-1 rounded-full bg-navy-50 px-2 py-1 text-xs font-medium text-navy-500">
                  <i class="fa-solid fa-lock-open"></i> Open
                </span>
              <% } %>
            </td>
            <td class="px-4 py-3 text-right">
              <% if (s.lock && s.lock.isLocked) { %>
                <form action="/teacher/assessments/locks/unlock" method="POST" class="inline">
                  <input type="hidden" name="subjectOfferingId" value="<%= s.subjectOfferingId %>" />
                  <input type="hidden" name="sectionId" value="<%= s.sectionId %>" />
                  <button type="submit" class="rounded-lg border border-navy-200 px-3 py-1.5 text-xs font-semibold text-navy-700 hover:bg-navy-50">
                    <i class="fa-solid fa-lock-open mr-1"></i>Unlock
                  </button>
                </form>
              <% } else { %>
                <form action="/teacher/assessments/locks/lock" method="POST" class="inline"
                      onsubmit="return confirm('Lock assessments for this section? You will not be able to create new assessments here until you unlock it.');">
                  <input type="hidden" name="subjectOfferingId" value="<%= s.subjectOfferingId %>" />
                  <input type="hidden" name="sectionId" value="<%= s.sectionId %>" />
                  <button type="submit" class="rounded-lg bg-amber-500 px-3 py-1.5 text-xs font-semibold text-navy-900 hover:bg-amber-400">
                    <i class="fa-solid fa-lock mr-1"></i>Lock
                  </button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
