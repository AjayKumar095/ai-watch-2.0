<h1 class="text-2xl font-bold text-navy-900">My Roster</h1>

<p class="mt-1 text-sm text-navy-500">
  Grouped by subject, program, and section — so you always know which class a student belongs to.
</p>

<div class="mt-6 space-y-3">

  <% if (!grouped.length) { %>

    <div class="card text-sm text-navy-400">
      You have no subject mappings yet.
    </div>

    <% } %>


      <% grouped.forEach(function(g, index) { %>

        <div class="overflow-hidden rounded-xl border border-navy-100 bg-white shadow-card">

          <!-- ============================= -->
          <!-- Accordion Header               -->
          <!-- ============================= -->

          <button type="button" class="flex w-full items-center gap-4 px-5 py-4 text-left transition hover:bg-navy-50"
            onclick="toggleRoster(<%= index %>)" aria-expanded="false" aria-controls="roster-content-<%= index %>"
            id="roster-button-<%= index %>">

            <!-- Subject Icon -->
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-info-100 text-info-600">

              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5S19.832 5.477 21 6.253v13C19.832 18.477 18.246 18 16.5 18s-3.332.477-4.5 1.253" />
              </svg>

            </div>


            <!-- Subject / Class Information -->
            <div class="min-w-0 flex-1">

              <div class="flex flex-wrap items-center gap-x-2 gap-y-1">

                <h2 class="truncate text-sm font-semibold text-navy-900 sm:text-base">
                  <%= g.mapping.SubjectOffering.SubjectPool.name %>
                </h2>

                <% if (g.mapping.Section) { %>

                  <span class="badge-navy whitespace-nowrap">
                    Section <%= g.mapping.Section.name %>
                  </span>

                  <% } else { %>

                    <span class="badge-navy whitespace-nowrap">
                      All Sections
                    </span>

                    <% } %>

              </div>


              <p class="mt-1 text-xs text-navy-400">

                <%= g.mapping.SubjectOffering.Program.name %>

                  <span class="mx-1">·</span>

                  Semester <%= g.mapping.SubjectOffering.semesterNumber %>

              </p>

            </div>


            <!-- Student Count -->
            <div class="shrink-0">

              <span
                class="inline-flex whitespace-nowrap items-center rounded-full bg-info-100 px-3 py-1 text-xs font-semibold text-info-800">

                <%= g.students.length %>

                  <span class="ml-1">
                    <%= g.students.length===1 ? 'student' : 'students' %>
                  </span>

              </span>

            </div>


            <!-- Chevron -->
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-navy-50">

              <svg id="roster-chevron-<%= index %>"
                class="h-4 w-4 shrink-0 text-navy-500 transition-transform duration-200" fill="none"
                stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 9l6 6 6-6" />
              </svg>

            </div>

          </button>


          <!-- ============================= -->
          <!-- Accordion Content              -->
          <!-- ============================= -->

          <div id="roster-content-<%= index %>" class="hidden border-t border-navy-100">

            <% if (g.students.length) { %>

              <!-- Scrollable Student List -->
              <div class="max-h-96 overflow-y-auto">

                <table class="min-w-full text-sm">

                  <!-- Table Header -->
                  <thead class="sticky top-0 z-10 bg-navy-50">

                    <tr class="text-left text-xs font-semibold uppercase tracking-wide text-navy-400">

                      <th class="w-12 px-5 py-3">
                        #
                      </th>

                      <th class="px-5 py-3">
                        Student
                      </th>

                      <th class="px-5 py-3">
                        Roll No
                      </th>

                      <th class="px-5 py-3">
                        Section
                      </th>

                    </tr>

                  </thead>


                  <!-- Students -->
                  <tbody class="divide-y divide-navy-50">

                    <% g.students.forEach(function(e, studentIndex) { %>

                      <tr class="transition hover:bg-navy-50">

                        <td class="whitespace-nowrap px-5 py-3 text-xs text-navy-400">
                          <%= studentIndex + 1 %>
                        </td>


                        <td class="whitespace-nowrap px-5 py-3 font-medium text-navy-800">

                          <%= e.StudentProfile.User.firstName %>
                            <%= e.StudentProfile.User.lastName %>

                        </td>


                        <td class="whitespace-nowrap px-5 py-3 text-navy-500">

                          <%= e.StudentProfile.rollNo %>

                        </td>


                        <td class="whitespace-nowrap px-5 py-3">

                          <% if (e.Section) { %>

                            <span class="badge-navy">
                              <%= e.Section.name %>
                            </span>

                            <% } else { %>

                              <span class="text-navy-400">
                                —
                              </span>

                              <% } %>

                        </td>

                      </tr>

                      <% }) %>

                  </tbody>

                </table>

              </div>


              <% } else { %>

                <div class="px-5 py-6 text-center">

                  <div class="mx-auto flex h-8 w-8 items-center justify-center">

                    <svg class="shrink-0 text-amber-500" style="max-width: 50px; max-height: 50px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                      aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M18 20a6 6 0 00-12 0m12 0H6m12 0h1a2 2 0 002-2v-5a2 2 0 00-2-2h-1m-12 0H5a2 2 0 00-2 2v5a2 2 0 002 2h1m0-9a4 4 0 118 0m-8 0a4 4 0 118 0" />
                    </svg>
          
                  </div>

                  <p class="mt-2 text-sm font-medium text-navy-600">
                    No students enrolled
                  </p>

                  <p class="mt-1 text-xs text-navy-400">
                    There are currently no students in this section.
                  </p>

                </div>

                <% } %>

          </div>

        </div>

        <% }) %>

</div>


<script>
  function toggleRoster(index) {

    const content = document.getElementById(`roster-content-${index}`);
    const button = document.getElementById(`roster-button-${index}`);
    const chevron = document.getElementById(`roster-chevron-${index}`);

    const isOpen = !content.classList.contains("hidden");

    if (isOpen) {

      content.classList.add("hidden");

      chevron.classList.remove("rotate-180");

      button.setAttribute("aria-expanded", "false");

    } else {

      content.classList.remove("hidden");

      chevron.classList.add("rotate-180");

      button.setAttribute("aria-expanded", "true");

    }
  }
</script>