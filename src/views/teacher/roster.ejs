<h1 class="text-2xl font-bold text-navy-900">My Roster</h1>
<p class="mt-1 text-sm text-navy-500">Grouped by subject, program, and section — so you always know which class a student belongs to.</p>

<div class="mt-6 space-y-4">
  <% if (!grouped.length) { %>
    <div class="card text-sm text-navy-400">You have no subject mappings yet.</div>
  <% } %>
  <% grouped.forEach(function(g) { %>
    <div class="card">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
          <h2 class="font-semibold text-navy-900">
            <%= g.mapping.SubjectOffering.SubjectPool.name %>
          </h2>
          <p class="text-xs text-navy-400">
            <%= g.mapping.SubjectOffering.Program.name %> · Semester <%= g.mapping.SubjectOffering.semesterNumber %>
            <% if (g.mapping.Section) { %> · Section <%= g.mapping.Section.name %><% } else { %> · All sections<% } %>
          </p>
        </div>
        <span class="badge-info"><%= g.students.length %> students</span>
      </div>
      <% if (g.students.length) { %>
        <div class="mt-3 overflow-x-auto">
          <table class="min-w-full divide-y divide-navy-100 text-sm">
            <thead>
              <tr class="text-left text-xs font-medium uppercase tracking-wide text-navy-400">
                <th class="py-2 pr-3">Student</th>
                <th class="py-2 pr-3">Roll No</th>
                <th class="py-2 pr-3">Section</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-navy-50">
              <% g.students.forEach(function(e) { %>
                <tr>
                  <td class="py-2 pr-3 font-medium text-navy-800"><%= e.StudentProfile.User.firstName %> <%= e.StudentProfile.User.lastName %></td>
                  <td class="py-2 pr-3 text-navy-500"><%= e.StudentProfile.rollNo %></td>
                  <td class="py-2 pr-3 text-navy-500"><%= e.Section ? e.Section.name : '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  <% }) %>
</div>
