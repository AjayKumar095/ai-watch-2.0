<div class="mx-auto mt-8 max-w-md">
  <div class="card">
    <% if (submitted) { %>
      <div class="text-center">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-info-100 text-info-700 text-2xl">✓</div>
        <h1 class="text-xl font-bold text-navy-900">Check your email</h1>
        <p class="mt-2 text-sm text-navy-500">
          If an account exists for that email and is active, we've sent a new temporary password to it.
        </p>
        <a href="/login" class="btn-secondary mt-6 inline-flex">Back to login</a>
      </div>
    <% } else { %>
      <h1 class="text-xl font-bold text-navy-900">Forgot password</h1>
      <p class="mt-1 text-sm text-navy-500">
        Enter your account email and we'll send you a new temporary password.
      </p>

      <% if (error) { %>
        <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= error %></div>
      <% } %>

      <form action="/forgot-password" method="POST" class="mt-6 space-y-4">
        <div>
          <label class="form-label" for="email">Email</label>
          <input class="form-input" type="email" id="email" name="email" required autofocus />
        </div>
        <button type="submit" class="btn-primary w-full">Send temporary password</button>
      </form>
      <p class="mt-4 text-center text-sm text-navy-500">
        <a href="/login" class="font-medium text-navy-700 hover:text-amber-600">Back to login</a>
      </p>
    <% } %>
  </div>
</div>
