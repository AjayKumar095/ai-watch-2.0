<div class="mx-auto mt-4 max-w-xl">
  <div class="card overflow-hidden !p-0">

    <!-- Progress -->
    <div class="border-b border-navy-100 bg-navy-50/60 px-6 py-4 sm:px-8">
      <div class="flex items-center justify-between text-xs font-medium text-navy-400">
        <span id="step-label">Step 1 of 4</span>
        <span id="step-title" class="text-navy-600">About you</span>
      </div>
      <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-navy-100">
        <div id="progress-bar" class="h-full rounded-full bg-amber-500 transition-all duration-500 ease-out" style="width: 25%"></div>
      </div>
    </div>

    <% if (error) { %>
      <div class="mx-6 mt-5 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800 sm:mx-8"><%= error %></div>
    <% } %>

    <form id="signup-form" action="/signup/student" method="POST" class="px-6 py-6 sm:px-8 sm:py-8">

      <!-- Step 1: About you -->
      <section class="signup-step" data-step="1">
        <img src="/images/gu-logo.webp" alt="Geeta University" class="h-9 w-auto rounded bg-white p-0.5 shadow-sm" />
        <h1 class="mt-4 text-2xl font-bold text-navy-900">Hey there. Let's get you set up.</h1>
        <p class="mt-1 text-sm text-navy-500">Four quick steps — should take about a minute.</p>

        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="form-label" for="firstName">First name</label>
            <input class="form-input" id="firstName" name="firstName" value="<%= formData.firstName || '' %>" required autofocus />
          </div>
          <div>
            <label class="form-label" for="lastName">Last name</label>
            <input class="form-input" id="lastName" name="lastName" value="<%= formData.lastName || '' %>" required />
          </div>
        </div>
        <div class="mt-4">
          <label class="form-label" for="email">Email</label>
          <input class="form-input" type="email" id="email" name="email" value="<%= formData.email || '' %>" required />
        </div>
        <p class="mt-3 text-xs text-navy-400">
          No password to set here — once your requested teacher approves your account, we'll email you a temporary login password.
        </p>
      </section>

      <!-- Step 2: Program -->
      <section class="signup-step hidden" data-step="2">
        <h1 class="text-2xl font-bold text-navy-900">Where are you studying?</h1>
        <p class="mt-1 text-sm text-navy-500">We'll use this to line you up with the right subjects.</p>

        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="form-label" for="schoolId">School</label>
            <select class="form-input" id="schoolId" name="schoolId" required>
              <option value="">Select a school</option>
              <% schools.forEach(function(s) { %>
                <option value="<%= s.id %>" <%= formData.schoolId === s.id ? 'selected' : '' %>><%= s.name %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="form-label" for="programId">Program</label>
            <select class="form-input" id="programId" name="programId" required disabled>
              <option value="">Select a school first</option>
            </select>
          </div>
        </div>
        <div class="mt-4">
          <label class="form-label" for="specializationId">Specialization <span class="font-normal text-navy-400">(if any)</span></label>
          <select class="form-input" id="specializationId" name="specializationId" disabled>
            <option value="">Select a program first</option>
          </select>
        </div>
      </section>

      <!-- Step 3: Class details -->
      <section class="signup-step hidden" data-step="3">
        <h1 class="text-2xl font-bold text-navy-900">What's your class?</h1>
        <p class="mt-1 text-sm text-navy-500">Your admission year stays fixed for your whole program — it's how we track which curriculum applies to you.</p>

        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div>
            <label class="form-label" for="rollNo">Roll number <span class="text-rose-500">*</span></label>
            <input class="form-input" id="rollNo" name="rollNo" value="<%= formData.rollNo || '' %>" placeholder="e.g. 24BBA001" required />
          </div>
          <div>
            <label class="form-label" for="admissionYear">Admission year <span class="text-rose-500">*</span></label>
            <select class="form-input" id="admissionYear" name="admissionYear" required>
              <option value="">Select year</option>
              <% if (typeof academicYears !== 'undefined' && academicYears && academicYears.length) { %>
                <% academicYears.forEach(function(y) { %>
                  <option value="<%= y.admissionYear %>" <%= String(formData.admissionYear || defaultYear) === String(y.admissionYear) ? 'selected' : '' %>><%= y.label %></option>
                <% }) %>
              <% } else { %>
                <% years.forEach(function(y) { %>
                  <option value="<%= y %>" <%= String(formData.admissionYear) === String(y) ? 'selected' : '' %>><%= y %></option>
                <% }) %>
              <% } %>
            </select>
          </div>
          <div>
            <label class="form-label" for="semesterNumber">Semester <span class="text-rose-500">*</span></label>
            <select class="form-input" id="semesterNumber" name="semesterNumber" required>
              <option value="1">Semester 1</option>
              <option value="2">Semester 2</option>
              <option value="3">Semester 3</option>
              <option value="4">Semester 4</option>
              <option value="5">Semester 5</option>
              <option value="6">Semester 6</option>
              <option value="7">Semester 7</option>
              <option value="8">Semester 8</option>
            </select>
          </div>
        </div>

        <div class="mt-4">
          <label class="form-label" for="sectionId">Section <span class="font-normal text-navy-400">(optional — pick later if you're not sure)</span></label>
          <select class="form-input" id="sectionId" name="sectionId" disabled>
            <option value="">Select school, program &amp; year first</option>
          </select>
        </div>
        <div class="mt-4 hidden" id="subgroup-wrapper">
          <label class="form-label" for="subGroupId">Sub-group</label>
          <select class="form-input" id="subGroupId" name="subGroupId">
            <option value="">None</option>
          </select>
        </div>
        <p id="no-sections-note" class="mt-3 hidden text-xs text-navy-400">
          Sections for this year haven't been set up yet — no problem, you'll be assigned one once your account is approved.
        </p>
      </section>

      <!-- Step 4: Mentor + submit -->
      <section class="signup-step hidden" data-step="4">
        <h1 class="text-2xl font-bold text-navy-900">Pick your mentor</h1>
        <p class="mt-1 text-sm text-navy-500">This teacher reviews and approves your request.</p>

        <input type="hidden" id="requestedTeacherId" name="requestedTeacherId" value="<%= formData.requestedTeacherId || '' %>" />
        <div class="no-scrollbar mt-6 grid max-h-72 grid-cols-1 gap-2 overflow-y-auto pr-1 sm:grid-cols-2">
          <% teachers.forEach(function(t) { %>
            <button type="button" class="teacher-card flex items-center gap-3 rounded-lg border border-navy-100 p-3 text-left transition hover:border-amber-300 hover:bg-amber-50" data-teacher-id="<%= t.id %>">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-navy-800 text-xs font-bold text-white">
                <%= t.User.firstName[0] %><%= t.User.lastName[0] %>
              </span>
              <span class="min-w-0">
                <span class="block truncate text-sm font-medium text-navy-800"><%= t.User.firstName %> <%= t.User.lastName %></span>
                <span class="block truncate text-xs text-navy-400"><%= t.employeeCode %></span>
              </span>
              <i class="fa-solid fa-circle-check ml-auto hidden text-lg text-amber-500 teacher-check"></i>
            </button>
          <% }) %>
        </div>
        <p class="mt-2 text-xs text-navy-400">This teacher will see your request in their "Pending Approvals" panel.</p>
      </section>

      <!-- Nav -->
      <div class="mt-8 flex items-center justify-between border-t border-navy-100 pt-5">
        <button type="button" id="back-btn" class="btn-secondary invisible">Back</button>
        <button type="button" id="next-btn" class="btn-primary">Continue</button>
        <button type="submit" id="submit-btn" class="btn-primary hidden">Submit request</button>
      </div>
    </form>
  </div>
</div>

<script id="signup-prefill-data" type="application/json">
  <%- JSON.stringify({
    programId: formData.programId || '',
    specializationId: formData.specializationId || '',
    semesterNumber: formData.semesterNumber || '1',
    sectionId: formData.sectionId || '',
    subGroupId: formData.subGroupId || ''
  }) %>
</script>

<script>
  (function () {
    var steps = Array.prototype.slice.call(document.querySelectorAll('.signup-step'));
    var total = steps.length;
    var current = 1;

    var stepLabel = document.getElementById('step-label');
    var stepTitle = document.getElementById('step-title');
    var progressBar = document.getElementById('progress-bar');
    var backBtn = document.getElementById('back-btn');
    var nextBtn = document.getElementById('next-btn');
    var submitBtn = document.getElementById('submit-btn');
    var titles = ['About you', 'Your program', 'Your class', 'Your mentor'];

    function showStep(n) {
      steps.forEach(function (el) {
        el.classList.toggle('hidden', parseInt(el.dataset.step, 10) !== n);
      });
      stepLabel.textContent = 'Step ' + n + ' of ' + total;
      stepTitle.textContent = titles[n - 1];
      progressBar.style.width = (n / total) * 100 + '%';
      backBtn.classList.toggle('invisible', n === 1);
      nextBtn.classList.toggle('hidden', n === total);
      submitBtn.classList.toggle('hidden', n !== total);
      current = n;
    }

    function currentStepEl() {
      return steps[current - 1];
    }

    function validateStep() {
      var inputs = currentStepEl().querySelectorAll('input, select');
      for (var i = 0; i < inputs.length; i++) {
        if (!inputs[i].disabled && !inputs[i].checkValidity()) {
          inputs[i].reportValidity();
          return false;
        }
      }
      if (current === 4 && !document.getElementById('requestedTeacherId').value) {
        alert('Please pick a mentor to continue.');
        return false;
      }
      return true;
    }

    nextBtn.addEventListener('click', function () {
      if (!validateStep()) return;
      if (current < total) showStep(current + 1);
    });
    backBtn.addEventListener('click', function () {
      if (current > 1) showStep(current - 1);
    });

    var schoolSelect = document.getElementById('schoolId');
    var programSelect = document.getElementById('programId');
    var specializationSelect = document.getElementById('specializationId');
    var admissionYearSelect = document.getElementById('admissionYear');
    var semesterSelect = document.getElementById('semesterNumber');
    var sectionSelect = document.getElementById('sectionId');
    var subGroupSelect = document.getElementById('subGroupId');
    var subGroupWrapper = document.getElementById('subgroup-wrapper');
    var noSectionsNote = document.getElementById('no-sections-note');

    var prefillData = JSON.parse(document.getElementById('signup-prefill-data').textContent || '{}');
    var prefillProgramId = prefillData.programId || '';
    var prefillSpecializationId = prefillData.specializationId || '';
    var prefillSemesterNumber = prefillData.semesterNumber || '1';
    var prefillSectionId = prefillData.sectionId || '';
    var prefillSubGroupId = prefillData.subGroupId || '';

    function setOptions(select, items, placeholder, selectedId) {
      select.innerHTML = '';
      var placeholderOpt = document.createElement('option');
      placeholderOpt.value = '';
      placeholderOpt.textContent = placeholder;
      select.appendChild(placeholderOpt);
      items.forEach(function (item) {
        var opt = document.createElement('option');
        opt.value = item.id;
        opt.textContent = item.name;
        if (selectedId && item.id === selectedId) opt.selected = true;
        select.appendChild(opt);
      });
    }

    function loadPrograms(schoolId, selectedProgramId) {
      if (!schoolId) {
        programSelect.disabled = true;
        setOptions(programSelect, [], 'Select a school first');
        specializationSelect.disabled = true;
        setOptions(specializationSelect, [], 'Select a program first');
        return;
      }
      fetch('/api/schools/' + schoolId + '/programs')
        .then(function (r) { return r.json(); })
        .then(function (programs) {
          programSelect.__programsData = programs;
          programSelect.disabled = false;
          setOptions(programSelect, programs, 'Select a program', selectedProgramId);
          if (selectedProgramId) {
            updateSemestersForProgram(selectedProgramId);
            loadSpecializations(selectedProgramId, prefillSpecializationId);
          }
          refreshSections();
        });
    }

    function loadSpecializations(programId, selectedSpecializationId) {
      if (!programId) {
        specializationSelect.disabled = true;
        setOptions(specializationSelect, [], 'Select a program first');
        return;
      }
      fetch('/api/programs/' + programId + '/specializations')
        .then(function (r) { return r.json(); })
        .then(function (specializations) {
          specializationSelect.disabled = false;
          setOptions(specializationSelect, specializations, 'None', selectedSpecializationId);
        });
    }

    function updateSemestersForProgram(programId) {
      if (!programId) return;
      var selected = (programSelect.__programsData || []).find(function (p) { return p.id === programId; });
      var total = selected && selected.totalSemesters ? selected.totalSemesters : 8;
      var curVal = semesterSelect.value || prefillSemesterNumber || '1';
      semesterSelect.innerHTML = '';
      for (var i = 1; i <= total; i++) {
        var opt = document.createElement('option');
        opt.value = i;
        opt.textContent = 'Semester ' + i;
        if (String(i) === String(curVal)) opt.selected = true;
        semesterSelect.appendChild(opt);
      }
    }

    function refreshSections() {
      var programId = programSelect.value;
      var year = admissionYearSelect.value;
      var sem = semesterSelect.value || 1;
      subGroupWrapper.classList.add('hidden');
      noSectionsNote.classList.add('hidden');

      if (!programId || !year) {
        sectionSelect.disabled = true;
        setOptions(sectionSelect, [], 'Select school, program & year first');
        return;
      }

      fetch('/api/programs/' + programId + '/years/' + year + '/sections?semesterNumber=' + sem)
        .then(function (r) { return r.json(); })
        .then(function (sections) {
          if (!sections.length) {
            sectionSelect.disabled = true;
            setOptions(sectionSelect, [], 'None set up yet — skip for now');
            noSectionsNote.classList.remove('hidden');
            return;
          }
          sectionSelect.disabled = false;
          setOptions(sectionSelect, sections, 'Select a section (optional)', prefillSectionId);
          sectionSelect.dataset.raw = JSON.stringify(sections);
          maybeShowSubGroups(sections);
        });
    }

    function maybeShowSubGroups(sections) {
      var chosen = sections.filter(function (s) { return s.id === sectionSelect.value; })[0];
      if (chosen && chosen.subGroups && chosen.subGroups.length) {
        setOptions(subGroupSelect, chosen.subGroups, 'None', prefillSubGroupId);
        subGroupWrapper.classList.remove('hidden');
      } else {
        subGroupWrapper.classList.add('hidden');
      }
    }

    sectionSelect.addEventListener('change', function () {
      var sections = JSON.parse(sectionSelect.dataset.raw || '[]');
      maybeShowSubGroups(sections);
    });
    admissionYearSelect.addEventListener('change', refreshSections);
    semesterSelect.addEventListener('change', refreshSections);

    schoolSelect.addEventListener('change', function () { loadPrograms(this.value, null); });
    programSelect.addEventListener('change', function () {
      updateSemestersForProgram(this.value);
      loadSpecializations(this.value, null);
      refreshSections();
    });

    if (schoolSelect.value) {
      loadPrograms(schoolSelect.value, prefillProgramId);
    }

    var teacherCards = Array.prototype.slice.call(document.querySelectorAll('.teacher-card'));
    var teacherInput = document.getElementById('requestedTeacherId');
    function selectTeacher(card) {
      teacherCards.forEach(function (c) {
        c.classList.remove('border-amber-400', 'bg-amber-50');
        c.querySelector('.teacher-check').classList.add('hidden');
      });
      card.classList.add('border-amber-400', 'bg-amber-50');
      card.querySelector('.teacher-check').classList.remove('hidden');
      teacherInput.value = card.dataset.teacherId;
    }
    teacherCards.forEach(function (card) {
      card.addEventListener('click', function () { selectTeacher(card); });
      if (teacherInput.value && card.dataset.teacherId === teacherInput.value) selectTeacher(card);
    });

    showStep(1);
  })();
</script>
