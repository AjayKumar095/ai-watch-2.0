<div class="mx-auto mt-8 max-w-xl">
  <div class="card">
    <div class="mb-2 flex items-center gap-2">
      <img src="/images/gu-logo.webp" alt="Geeta University" class="h-8 w-auto rounded bg-white p-0.5" />
    </div>
    <h1 class="text-xl font-bold text-navy-900">Student Onboarding</h1>
    <p class="mt-1 text-sm text-navy-500">
      Your account is activated once the teacher you select below approves your request.
    </p>

    <% if (error) { %>
      <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= error %></div>
    <% } %>

    <form id="signup-form" action="/signup/student" method="POST" class="mt-6 space-y-4">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label class="form-label" for="firstName">First name</label>
          <input class="form-input" id="firstName" name="firstName" value="<%= formData.firstName || '' %>" required />
        </div>
        <div>
          <label class="form-label" for="lastName">Last name</label>
          <input class="form-input" id="lastName" name="lastName" value="<%= formData.lastName || '' %>" required />
        </div>
      </div>

      <div>
        <label class="form-label" for="email">Email</label>
        <input class="form-input" type="email" id="email" name="email" value="<%= formData.email || '' %>" required />
      </div>

      <p class="text-xs text-navy-400">
        No password to set here — once your requested teacher approves your account, we'll email you a
        temporary login password.
      </p>

      <div>
        <label class="form-label" for="rollNo">Roll number</label>
        <input class="form-input" id="rollNo" name="rollNo" value="<%= formData.rollNo || '' %>" required />
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label class="form-label" for="schoolId">School</label>
          <select class="form-input" id="schoolId" name="schoolId" required>
            <option value="">Select a school</option>
            <% schools.forEach(function(s) { %>
              <option value="<%= s.id %>" <%= formData.schoolId === s.id ? 'selected' : '' %>><%= s.name %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="form-label" for="programId">Program</label>
          <select class="form-input" id="programId" name="programId" required disabled>
            <option value="">Select a school first</option>
          </select>
        </div>
      </div>

      <div>
        <label class="form-label" for="specializationId">Specialization (if any)</label>
        <select class="form-input" id="specializationId" name="specializationId" disabled>
          <option value="">Select a program first</option>
        </select>
      </div>

      <div>
        <label class="form-label" for="requestedTeacherId">Request approval from</label>
        <select class="form-input" id="requestedTeacherId" name="requestedTeacherId" required>
          <option value="">Select a teacher</option>
          <% teachers.forEach(function(t) { %>
            <option value="<%= t.id %>" <%= formData.requestedTeacherId === t.id ? 'selected' : '' %>>
              <%= t.User.firstName %> <%= t.User.lastName %> (<%= t.employeeCode %>)
            </option>
          <% }) %>
        </select>
        <p class="mt-1 text-xs text-navy-400">This teacher will see your request in their "Pending Approvals" panel.</p>
      </div>

      <button type="submit" class="btn-primary w-full">Submit request</button>
    </form>
  </div>
</div>

<script>
  (function () {
    var schoolSelect = document.getElementById('schoolId');
    var programSelect = document.getElementById('programId');
    var specializationSelect = document.getElementById('specializationId');

    // Re-render state, so a validation-error re-render can restore the
    // student's previous selections instead of resetting the cascade.
    var prefillProgramId = <%- JSON.stringify(formData.programId || '') %>;
    var prefillSpecializationId = <%- JSON.stringify(formData.specializationId || '') %>;

    function setOptions(select, items, placeholder, selectedId) {
      select.innerHTML = '';
      var placeholderOpt = document.createElement('option');
      placeholderOpt.value = '';
      placeholderOpt.textContent = placeholder;
      select.appendChild(placeholderOpt);
      items.forEach(function (item) {
        var opt = document.createElement('option');
        opt.value = item.id;
        opt.textContent = item.name;
        if (selectedId && item.id === selectedId) opt.selected = true;
        select.appendChild(opt);
      });
    }

    function loadPrograms(schoolId, selectedProgramId) {
      if (!schoolId) {
        programSelect.disabled = true;
        setOptions(programSelect, [], 'Select a school first');
        specializationSelect.disabled = true;
        setOptions(specializationSelect, [], 'Select a program first');
        return;
      }
      fetch('/api/schools/' + schoolId + '/programs')
        .then(function (r) { return r.json(); })
        .then(function (programs) {
          programSelect.disabled = false;
          setOptions(programSelect, programs, 'Select a program', selectedProgramId);
          if (selectedProgramId) loadSpecializations(selectedProgramId, prefillSpecializationId);
        });
    }

    function loadSpecializations(programId, selectedSpecializationId) {
      if (!programId) {
        specializationSelect.disabled = true;
        setOptions(specializationSelect, [], 'Select a program first');
        return;
      }
      fetch('/api/programs/' + programId + '/specializations')
        .then(function (r) { return r.json(); })
        .then(function (specializations) {
          specializationSelect.disabled = false;
          setOptions(specializationSelect, specializations, 'None', selectedSpecializationId);
        });
    }

    schoolSelect.addEventListener('change', function () {
      loadPrograms(this.value, null);
    });
    programSelect.addEventListener('change', function () {
      loadSpecializations(this.value, null);
    });

    // On initial load (e.g. re-render after a validation error), restore
    // the cascade from whatever was previously selected.
    if (schoolSelect.value) {
      loadPrograms(schoolSelect.value, prefillProgramId);
    }
  })();
</script>
