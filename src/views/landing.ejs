      <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-amber-500/20 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-info-500/10 blur-3xl"></div>

      <div class="relative mx-auto max-w-3xl text-center">
        <img src="/images/gu-logo.webp" alt="Geeta University" class="mx-auto mb-2 h-9 w-auto rounded-lg bg-white p-1 shadow-lg sm:mb-3 sm:h-14" />
        <p class="text-[10px] font-semibold uppercase tracking-widest text-amber-400 sm:text-[11px]">A Geeta University Initiative</p>
        <h1 class="mt-1.5 text-xl font-bold leading-tight tracking-tight sm:mt-2 sm:text-4xl">
          AI-Watch <span class="text-amber-400">Assessment Portal</span>
        </h1>
        <p class="mx-auto mt-1.5 hidden max-w-xl text-sm text-navy-100 sm:mt-2 sm:block sm:text-base">
          One home for AI-focused coursework at Geeta University — assignments, evaluation, and progress
          tracking for students, teachers, and administrators.
        </p>
        <p class="mx-auto mt-1.5 max-w-xs text-xs text-navy-100 sm:hidden">
          AI-focused coursework, evaluation, and progress tracking at Geeta University.
        </p>

        <div class="mt-3 flex flex-wrap items-center justify-center gap-2 sm:mt-4 sm:gap-3">
          <a href="/signup/student" class="btn-primary !px-5 !py-2 text-xs sm:!px-6 sm:!py-2.5 sm:text-base">Student Sign Up</a>
          <a href="/login" class="inline-flex items-center justify-center rounded-lg border border-white/30 px-5 py-2 text-xs font-semibold text-white transition hover:bg-white/10 sm:px-6 sm:py-2.5 sm:text-base">
            Log in
          </a>
        </div>

        <div class="mt-3 hidden flex-wrap items-center justify-center gap-x-5 gap-y-1.5 text-[11px] text-navy-200 sm:mt-4 sm:flex sm:text-xs">
          <span><i class="fa-solid fa-layer-group mr-1 text-amber-400"></i>University-wide subjects</span>
          <span><i class="fa-solid fa-diagram-project mr-1 text-info-400"></i>Section-aware assignments</span>
          <span><i class="fa-solid fa-certificate mr-1 text-amber-400"></i>Verified certificates</span>
          <span><i class="fa-solid fa-shield-halved mr-1 text-info-400"></i>Teacher-approved onboarding</span>
        </div>
      </div>
    </section>

    <!-- Role highlights -->
    <section class="mx-auto w-full max-w-6xl">
      <div class="grid grid-cols-3 gap-2 sm:gap-4">
        <div class="card !p-2.5 text-center sm:!p-4 sm:text-left">
          <div class="mx-auto mb-1 flex h-7 w-7 items-center justify-center rounded-lg bg-info-100 text-info-700 sm:mx-0 sm:mb-2 sm:h-9 sm:w-9">
            <i class="fa-solid fa-user-graduate text-xs sm:text-base"></i>
          </div>
          <h3 class="text-xs font-semibold text-navy-900 sm:text-sm">For Students</h3>
          <p class="mt-1 hidden text-xs leading-snug text-navy-500 sm:block">See assessments for your section, submit work, and track evaluated results.</p>
        </div>
        <div class="card !p-2.5 text-center sm:!p-4 sm:text-left">
          <div class="mx-auto mb-1 flex h-7 w-7 items-center justify-center rounded-lg bg-amber-100 text-amber-700 sm:mx-0 sm:mb-2 sm:h-9 sm:w-9">
            <i class="fa-solid fa-chalkboard-user text-xs sm:text-base"></i>
          </div>
          <h3 class="text-xs font-semibold text-navy-900 sm:text-sm">For Teachers</h3>
          <p class="mt-1 hidden text-xs leading-snug text-navy-500 sm:block">Create and grade assessments, approve student accounts, manage submissions in bulk.</p>
        </div>
        <div class="card !p-2.5 text-center sm:!p-4 sm:text-left">
