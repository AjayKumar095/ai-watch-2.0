<%
  let navGroups = [];
  if (currentUser.role === 'SUPERADMIN') {
    navGroups = [
      { section: null, items: [
        { href: '/admin/dashboard', icon: 'fa-gauge', label: 'Dashboard' },
      ]},
      { section: 'Academic Structure', items: [
        { href: '/admin/schools', icon: 'fa-building-columns', label: 'Schools' },
        { href: '/admin/programs', icon: 'fa-graduation-cap', label: 'Programs' },
        { href: '/admin/academic-years', icon: 'fa-calendar-days', label: 'Academic Years' },
        { href: '/admin/subjects', icon: 'fa-book', label: 'Subject Pool' },
        { href: '/admin/subject-offerings', icon: 'fa-layer-group', label: 'Subject Offerings' },
      ]},
      { section: 'People', items: [
        { href: '/admin/teachers', icon: 'fa-chalkboard-user', label: 'Teachers' },
        { href: '/admin/students', icon: 'fa-user-graduate', label: 'Students' },
        { href: '/admin/users', icon: 'fa-users-gear', label: 'Users' },
        { href: '/admin/mappings', icon: 'fa-diagram-project', label: 'Teacher Mappings' },
        { href: '/admin/enroll', icon: 'fa-user-plus', label: 'Enroll Students' },
      ]},
      { section: 'Term Rollover', items: [
        { href: '/admin/session-clone', icon: 'fa-clone', label: 'Clone to New Year' },
        { href: '/admin/promotions', icon: 'fa-arrow-trend-up', label: 'Promotions' },
        { href: '/admin/certificates', icon: 'fa-certificate', label: 'Certificates' },
        { href: '/admin/audit-log', icon: 'fa-clipboard-list', label: 'Audit Log' },
        { href: '/admin/system-logs', icon: 'fa-file-lines', label: 'System Logs' },
      ]},
    ];
  } else if (currentUser.role === 'TEACHER') {
    navGroups = [
      { section: null, items: [
        { href: '/teacher/dashboard', icon: 'fa-gauge', label: 'Dashboard' },
        { href: '/teacher/roster', icon: 'fa-users', label: 'My Roster' },
        { href: '/teacher/enroll', icon: 'fa-user-plus', label: 'Enroll Students' },
        { href: '/teacher/assessments', icon: 'fa-file-lines', label: 'Assessments' },
        { href: '/teacher/assessments/locks', icon: 'fa-lock', label: 'Assessment Locks' },
      ]},
    ];
  } else if (currentUser.role === 'STUDENT') {
    navGroups = [
      { section: null, items: [
        { href: '/student/dashboard', icon: 'fa-gauge', label: 'Dashboard' },
        { href: '/student/certificates', icon: 'fa-award', label: 'My Certificate' },
        { href: '/student/profile', icon: 'fa-id-card', label: 'My Profile' },
        
      ]},
    ];
  }
%>
<div class="flex h-full flex-col text-navy-100">
  <div class="flex items-center gap-2 px-4 py-4 text-lg font-bold text-white">
    <img src="/images/gu-logo.webp" alt="Geeta University" class="h-9 w-auto rounded bg-white p-1" />
    <span>AI-Watch</span>
  </div>
  <nav class="flex-1 space-y-4 overflow-y-auto px-2 pb-4">
    <% navGroups.forEach(function(group) { %>
      <div>
        <% if (group.section) { %><p class="px-3 pb-1 pt-2 text-xs font-semibold uppercase tracking-wide text-navy-500"><%= group.section %></p><% } %>
        <%
          // Longest-matching href in this group wins, so a parent route
          // (e.g. /teacher/assessments) doesn't also light up alongside a
          // more specific child route (e.g. /teacher/assessments/locks)
          // just because the child path starts with the parent's href.
          let bestLen = -1;
          if (typeof currentPath !== 'undefined' && currentPath) {
            group.items.forEach(function(it) {
              const matches = currentPath === it.href || currentPath.startsWith(it.href + '/');
              if (matches && it.href.length > bestLen) bestLen = it.href.length;
            });
          }
        %>
        <% group.items.forEach(function(item) {
             const matches = typeof currentPath !== 'undefined' && currentPath &&
               (currentPath === item.href || currentPath.startsWith(item.href + '/'));
             const isActive = matches && item.href.length === bestLen;
        %>
          <a href="<%= item.href %>" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium <%= isActive ? 'bg-amber-500 text-navy-900' : 'text-navy-100 hover:bg-navy-800' %>">
            <i class="fa-solid <%= item.icon %> w-4 text-center"></i>
            <%= item.label %>
          </a>
        <% }) %>
      </div>
    <% }) %>
  </nav>
  <div class="border-t border-navy-800 px-4 py-3">
    <p class="truncate text-xs text-navy-400"><%= currentUser.email %></p>
    <a href="/account/change-password" class="mt-2 block text-xs font-medium text-navy-300 hover:text-amber-400">
      <i class="fa-solid fa-key mr-1"></i> Change Password
    </a>
    <form action="/logout" method="POST" class="mt-2">
      <button type="submit" class="w-full rounded-lg border border-navy-700 px-3 py-1.5 text-xs font-medium text-navy-100 hover:bg-navy-800">
        <i class="fa-solid fa-arrow-right-from-bracket mr-1"></i> Log out
      </button>
    </form>
  </div>
</div>
