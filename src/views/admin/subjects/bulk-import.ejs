<div class="mx-auto mt-4 max-w-2xl">
  <div class="card">
    <h1 class="text-xl font-bold text-navy-900">Bulk Import Subjects</h1>
    <p class="mt-1 text-sm text-navy-500">Columns: name, code, category (UNIVERSITY_WIDE or PROGRAM_SPECIFIC — optional, defaults to University-Wide).</p>

    <% if (error) { %><div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= error %></div><% } %>

    <% if (result) { %>
      <div class="mt-4 rounded-lg border border-info-200 bg-info-50 px-3 py-2 text-sm text-info-800">
        <%= result.created.length %> created, <%= result.skipped.length %> skipped.
      </div>
      <% if (result.skipped.length) { %>
        <div class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800">
          <strong>Skipped rows:</strong>
          <ul class="mt-1 list-disc pl-4">
            <% result.skipped.forEach(function(s) { %><li><%= s.line %> — <%= s.reason %></li><% }) %>
          </ul>
        </div>
      <% } %>
    <% } %>

    <div class="mt-6">
      <h2 class="text-sm font-semibold text-navy-800">Option A — Upload a CSV file</h2>
      <form action="/admin/subjects/bulk-import" method="POST" enctype="multipart/form-data" class="mt-2 flex items-center gap-3">
        <input type="file" name="csvFile" accept=".csv,text/csv" class="form-input !py-1.5 text-sm" required />
        <button type="submit" class="btn-primary shrink-0">Upload & Import</button>
      </form>
    </div>

    <div class="relative my-6 flex items-center">
      <div class="flex-1 border-t border-navy-100"></div>
      <span class="px-3 text-xs uppercase text-navy-300">or</span>
      <div class="flex-1 border-t border-navy-100"></div>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-navy-800">Option B — Paste CSV text</h2>
      <form action="/admin/subjects/bulk-import" method="POST" class="mt-2 space-y-3">
        <textarea class="form-input font-mono text-xs" name="csvText" rows="6" placeholder="name,code,category&#10;AI for All,GEN-AI-101,UNIVERSITY_WIDE&#10;Corporate Finance,FIN-301,PROGRAM_SPECIFIC"></textarea>
        <button type="submit" class="btn-secondary">Import pasted text</button>
      </form>
    </div>
  </div>
</div>
