<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-navy-900">Subject Pool</h1>
  <div class="flex gap-2">
    <a href="/admin/subjects/bulk-import" class="btn-secondary">Bulk Import (CSV)</a>
    <a href="/admin/subjects/new" class="btn-primary">+ Add Subject</a>
  </div>
</div>

<% if (typeof bulkMessage !== 'undefined' && bulkMessage) { %>
  <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= bulkMessage %></div>
<% } %>

<div class="card">
  <form action="/admin/subjects/bulk-delete" method="POST">
    <div class="mb-3 flex items-center justify-between">
      <span class="text-xs text-navy-400">Select subjects to bulk-delete. In-use subjects are skipped automatically.</span>
      <button type="submit" class="btn-secondary !border-amber-300 !text-amber-700 hover:!bg-amber-50 text-xs" onclick="return confirm('Delete all selected subjects? Any still in use will be skipped instead of deleted.');">Delete selected</button>
    </div>
    <table class="min-w-full divide-y divide-navy-100 text-sm">
      <thead><tr class="text-left text-xs font-medium uppercase tracking-wide text-navy-400">
        <th class="py-2 pr-3"><input type="checkbox" onclick="document.querySelectorAll('.subject-check').forEach(c=>c.checked=this.checked)" /></th>
        <th class="py-2 pr-3">Name</th><th class="py-2 pr-3">Code</th><th class="py-2 pr-3">Category</th><th class="py-2 pr-3">Status</th><th class="py-2 pr-3"></th>
      </tr></thead>
      <tbody class="divide-y divide-navy-50">
        <% subjects.forEach(function(s) { %>
          <tr>
            <td class="py-2 pr-3"><input class="subject-check" type="checkbox" name="subjectIds" value="<%= s.id %>" /></td>
            <td class="py-2 pr-3 font-medium text-navy-800"><%= s.name %></td>
            <td class="py-2 pr-3 text-navy-500"><%= s.code %></td>
            <td class="py-2 pr-3"><span class="<%= s.category === 'UNIVERSITY_WIDE' ? 'badge-info' : 'badge-navy' %>"><%= s.category %></span></td>
            <td class="py-2 pr-3"><span class="<%= s.isActive ? 'badge-info' : 'badge-amber' %>"><%= s.isActive ? 'Active' : 'Inactive' %></span></td>
            <td class="py-2 pr-3">
              <div class="flex gap-2">
                <a href="/admin/subjects/<%= s.id %>/edit" class="btn-ghost text-xs">Edit</a>
                <button type="submit" formaction="/admin/subjects/<%= s.id %>/toggle" class="btn-ghost text-xs"><%= s.isActive ? 'Deactivate' : 'Activate' %></button>
              </div>
            </td>
          </tr>
        <% }) %>
        <% if (!subjects.length) { %><tr><td colspan="6" class="py-4 text-navy-400">No subjects yet.</td></tr><% } %>
      </tbody>
    </table>
  </form>
</div>
