<div class="mx-auto mt-4 max-w-lg">
  <div class="card">
    <h1 class="text-xl font-bold text-navy-900">Edit Subject</h1>
    <% if (error) { %><div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= error %></div><% } %>
    <form action="/admin/subjects/<%= subject.id %>/edit" method="POST" class="mt-6 space-y-4">
      <div><label class="form-label">Name</label><input class="form-input" name="name" value="<%= subject.name %>" required /></div>
      <div><label class="form-label">Code</label><input class="form-input" name="code" value="<%= subject.code %>" required /></div>
      <div>
        <label class="form-label">Category</label>
        <select class="form-input" name="category">
          <option value="UNIVERSITY_WIDE" <%= subject.category === 'UNIVERSITY_WIDE' ? 'selected' : '' %>>University-Wide</option>
          <option value="PROGRAM_SPECIFIC" <%= subject.category === 'PROGRAM_SPECIFIC' ? 'selected' : '' %>>Program-Specific</option>
        </select>
      </div>
      <button type="submit" class="btn-primary w-full">Save changes</button>
    </form>
    <form action="/admin/subjects/<%= subject.id %>/delete" method="POST" class="mt-3" onsubmit="return confirm('Delete this subject? This cannot be undone.');">
      <button type="submit" class="btn-secondary w-full !border-amber-300 !text-amber-700 hover:!bg-amber-50">Delete subject</button>
    </form>
  </div>
</div>
