<div class="mx-auto mt-4 max-w-lg">
  <div class="card">
    <h1 class="text-xl font-bold text-navy-900">Add Subject</h1>
    <% if (error) { %><div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= error %></div><% } %>
    <form action="/admin/subjects/new" method="POST" class="mt-6 space-y-4">
      <div><label class="form-label">Name</label><input class="form-input" name="name" value="<%= formData.name || '' %>" required /></div>
      <div><label class="form-label">Code</label><input class="form-input" name="code" value="<%= formData.code || '' %>" required /></div>
      <div>
        <label class="form-label">Category</label>
        <select class="form-input" name="category">
          <option value="UNIVERSITY_WIDE">University-Wide (e.g. "AI for All")</option>
          <option value="PROGRAM_SPECIFIC">Program-Specific</option>
        </select>
      </div>
      <button type="submit" class="btn-primary w-full">Add subject</button>
    </form>
  </div>
</div>
