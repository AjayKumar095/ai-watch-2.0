<div class="mx-auto mt-4 max-w-lg">
  <div class="card">
    <h1 class="text-xl font-bold text-navy-900">Add School</h1>
    <% if (error) { %><div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= error %></div><% } %>
    <form action="/admin/schools/new" method="POST" class="mt-6 space-y-4">
      <div><label class="form-label">Name</label><input class="form-input" name="name" value="<%= formData.name || '' %>" required /></div>
      <div><label class="form-label">Code</label><input class="form-input" name="code" value="<%= formData.code || '' %>" required /></div>
      <button type="submit" class="btn-primary w-full">Create school</button>
    </form>
  </div>
</div>
