<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-navy-900">Schools</h1>
  <a href="/admin/schools/new" class="btn-primary">+ Add School</a>
</div>
<div class="card">
  <table class="min-w-full divide-y divide-navy-100 text-sm">
    <thead><tr class="text-left text-xs font-medium uppercase tracking-wide text-navy-400">
      <th class="py-2 pr-3">Name</th><th class="py-2 pr-3">Code</th><th class="py-2 pr-3">Status</th><th class="py-2 pr-3"></th>
    </tr></thead>
    <tbody class="divide-y divide-navy-50">
      <% schools.forEach(function(s) { %>
        <tr>
          <td class="py-2 pr-3 font-medium text-navy-800"><%= s.name %></td>
          <td class="py-2 pr-3 text-navy-500"><%= s.code %></td>
          <td class="py-2 pr-3"><span class="<%= s.isActive ? 'badge-info' : 'badge-amber' %>"><%= s.isActive ? 'Active' : 'Inactive' %></span></td>
          <td class="py-2 pr-3">
            <div class="flex gap-2">
              <a href="/admin/schools/<%= s.id %>/edit" class="btn-ghost text-xs">Edit</a>
              <form action="/admin/schools/<%= s.id %>/toggle" method="POST">
                <button class="btn-ghost text-xs"><%= s.isActive ? 'Deactivate' : 'Activate' %></button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
      <% if (!schools.length) { %><tr><td colspan="4" class="py-4 text-navy-400">No schools yet.</td></tr><% } %>
    </tbody>
  </table>
</div>
