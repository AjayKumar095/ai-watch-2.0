<div class="mx-auto mt-4 max-w-lg">
  <div class="card">
    <h1 class="text-xl font-bold text-navy-900">Edit Teacher</h1>
    <% if (error) { %><div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= error %></div><% } %>
    <form action="/admin/teachers/<%= teacher.id %>/edit" method="POST" class="mt-6 space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div><label class="form-label">First name</label><input class="form-input" name="firstName" value="<%= teacher.User.firstName %>" required /></div>
        <div><label class="form-label">Last name</label><input class="form-input" name="lastName" value="<%= teacher.User.lastName %>" required /></div>
      </div>
      <div><label class="form-label">Email</label><input class="form-input" value="<%= teacher.User.email %>" disabled /></div>
      <div class="grid grid-cols-2 gap-4">
        <div><label class="form-label">Employee code</label><input class="form-input" name="employeeCode" value="<%= teacher.employeeCode %>" required /></div>
        <div><label class="form-label">Designation</label><input class="form-input" name="designation" value="<%= teacher.designation || '' %>" /></div>
      </div>
      <div>
        <label class="form-label">School</label>
        <select class="form-input" name="schoolId" required>
          <% schools.forEach(function(s) { %><option value="<%= s.id %>" <%= teacher.schoolId === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %>
        </select>
      </div>
      <label class="flex items-center gap-2 text-sm text-navy-700">
        <input type="checkbox" name="isActive" <%= teacher.User.isActive ? 'checked' : '' %> /> Account active (can log in)
      </label>
      <button type="submit" class="btn-primary w-full">Save changes</button>
    </form>
    <form action="/admin/teachers/<%= teacher.id %>/delete" method="POST" class="mt-3" onsubmit="return confirm('Delete this teacher account? This cannot be undone.');">
      <button type="submit" class="btn-secondary w-full !border-amber-300 !text-amber-700 hover:!bg-amber-50">Delete teacher</button>
    </form>
  </div>
</div>
