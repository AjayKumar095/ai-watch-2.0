<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-navy-900">Teachers</h1>
  <a href="/admin/teachers/new" class="btn-primary">+ Create Teacher</a>
</div>
<div class="card">
  <table class="min-w-full divide-y divide-navy-100 text-sm">
    <thead><tr class="text-left text-xs font-medium uppercase tracking-wide text-navy-400">
      <th class="py-2 pr-3">Name</th><th class="py-2 pr-3">Employee Code</th><th class="py-2 pr-3">School</th><th class="py-2 pr-3">Status</th><th class="py-2 pr-3"></th>
    </tr></thead>
    <tbody class="divide-y divide-navy-50">
      <% teachers.forEach(function(t) { %>
        <tr>
          <td class="py-2 pr-3 font-medium text-navy-800"><%= t.User.title %> <%= t.User.firstName %> <%= t.User.lastName %></td>
          <td class="py-2 pr-3 text-navy-500"><%= t.employeeCode %></td>
          <td class="py-2 pr-3 text-navy-500"><%= t.School.name %></td>
          <td class="py-2 pr-3"><span class="<%= t.User.isActive ? 'badge-info' : 'badge-amber' %>"><%= t.User.isActive ? 'Active' : 'Inactive' %></span></td>
          <td class="py-2 pr-3"><a href="/admin/teachers/<%= t.id %>/edit" class="btn-ghost text-xs">Edit</a></td>
        </tr>
      <% }) %>
      <% if (!teachers.length) { %><tr><td colspan="5" class="py-4 text-navy-400">No teachers yet.</td></tr><% } %>
    </tbody>
  </table>
</div>
