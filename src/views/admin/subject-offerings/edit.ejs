<div class="mx-auto mt-4 max-w-lg">
  <div class="card">
    <h1 class="text-xl font-bold text-navy-900">Edit Subject Offering</h1>
    <p class="mt-1 text-sm text-navy-500">
      <%= offering.SubjectPool.name %> — <%= offering.Program.name %> Semester <%= offering.semesterNumber %>
      (<%= offering.AcademicSession.label %>)
    </p>
    <p class="mt-1 text-xs text-navy-400">Subject, program, semester, and session can't be changed here — delete and recreate the offering instead if those need to change.</p>

    <% if (error) { %><div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= error %></div><% } %>

    <form action="/admin/subject-offerings/<%= offering.id %>/edit" method="POST" class="mt-6 space-y-4">
      <div>
        <label class="form-label">Specialization (optional)</label>
        <select class="form-input" name="specializationId">
          <option value="">None (all specializations)</option>
          <% specializations.forEach(function(sp) { %>
            <option value="<%= sp.id %>" <%= offering.specializationId === sp.id ? 'selected' : '' %>><%= sp.name %></option>
          <% }) %>
        </select>
      </div>
      <label class="flex items-center gap-2 text-sm text-navy-700">
        <input type="checkbox" name="isActive" <%= offering.isActive ? 'checked' : '' %> /> Active (available for enrollment and mapping)
      </label>
      <button type="submit" class="btn-primary w-full">Save changes</button>
    </form>

    <form action="/admin/subject-offerings/<%= offering.id %>/delete" method="POST" class="mt-3" onsubmit="return confirm('Delete this subject offering? This cannot be undone.');">
      <button type="submit" class="btn-secondary w-full !border-amber-300 !text-amber-700 hover:!bg-amber-50">Delete offering</button>
    </form>
  </div>
</div>
