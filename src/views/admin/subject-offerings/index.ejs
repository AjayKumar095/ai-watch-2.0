<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-navy-900">Subject Offerings</h1>
  <div class="flex gap-2">
    <a href="/admin/subject-offerings/bulk-attach" class="btn-secondary">Bulk Attach to Programs</a>
    <a href="/admin/subject-offerings/new" class="btn-primary">+ Add Offering</a>
  </div>
</div>
<div class="card">
  <table class="min-w-full divide-y divide-navy-100 text-sm">
    <thead><tr class="text-left text-xs font-medium uppercase tracking-wide text-navy-400">
      <th class="py-2 pr-3">Subject</th><th class="py-2 pr-3">Program</th><th class="py-2 pr-3">Semester</th><th class="py-2 pr-3">Specialization</th><th class="py-2 pr-3">Session</th>
    </tr></thead>
    <tbody class="divide-y divide-navy-50">
      <% offerings.forEach(function(o) { %>
        <tr>
          <td class="py-2 pr-3 font-medium text-navy-800"><%= o.SubjectPool.name %></td>
          <td class="py-2 pr-3 text-navy-500"><%= o.Program.name %></td>
          <td class="py-2 pr-3 text-navy-500"><%= o.semesterNumber %></td>
          <td class="py-2 pr-3 text-navy-500"><%= o.Specialization ? o.Specialization.name : '—' %></td>
          <td class="py-2 pr-3 text-navy-500"><%= o.AcademicSession.label %></td>
        </tr>
      <% }) %>
      <% if (!offerings.length) { %><tr><td colspan="5" class="py-4 text-navy-400">No subject offerings yet.</td></tr><% } %>
    </tbody>
  </table>
</div>
