<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-navy-900">Subject Offerings</h1>
  <div class="flex gap-2">
    <a href="/admin/subject-offerings/bulk-attach" class="btn-secondary">Bulk Attach to Programs</a>
    <a href="/admin/subject-offerings/new" class="btn-primary">+ Add Offering</a>
  </div>
</div>

<% if (typeof bulkMessage !== 'undefined' && bulkMessage) { %>
  <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= bulkMessage %></div>
<% } %>

<div class="card">
  <form action="/admin/subject-offerings/bulk-delete" method="POST">
    <div class="mb-3 flex items-center justify-between">
      <span class="text-xs text-navy-400">Select offerings to bulk-delete. In-use ones (with assessments or enrollments) are skipped automatically.</span>
      <button type="submit" class="btn-secondary !border-amber-300 !text-amber-700 hover:!bg-amber-50 text-xs" onclick="return confirm('Delete all selected subject offerings? Any still in use will be skipped instead of deleted.');">Delete selected</button>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-navy-100 text-sm">
        <thead><tr class="text-left text-xs font-medium uppercase tracking-wide text-navy-400">
          <th class="py-2 pr-3"><input type="checkbox" onclick="document.querySelectorAll('.offering-check').forEach(c=>c.checked=this.checked)" /></th>
          <th class="py-2 pr-3">Subject</th><th class="py-2 pr-3">Program</th><th class="py-2 pr-3">Semester</th>
          <th class="py-2 pr-3">Specialization</th><th class="py-2 pr-3">Session</th><th class="py-2 pr-3">Status</th><th class="py-2 pr-3"></th>
        </tr></thead>
        <tbody class="divide-y divide-navy-50">
          <% offerings.forEach(function(o) { %>
            <tr>
              <td class="py-2 pr-3"><input class="offering-check" type="checkbox" name="offeringIds" value="<%= o.id %>" /></td>
              <td class="py-2 pr-3 font-medium text-navy-800"><%= o.SubjectPool.name %></td>
              <td class="py-2 pr-3 text-navy-500"><%= o.Program.name %></td>
              <td class="py-2 pr-3 text-navy-500"><%= o.semesterNumber %></td>
              <td class="py-2 pr-3 text-navy-500"><%= o.Specialization ? o.Specialization.name : '—' %></td>
              <td class="py-2 pr-3 text-navy-500"><%= o.AcademicSession.label %></td>
              <td class="py-2 pr-3"><span class="<%= o.isActive ? 'badge-info' : 'badge-amber' %>"><%= o.isActive ? 'Active' : 'Inactive' %></span></td>
              <td class="py-2 pr-3">
                <div class="flex gap-2">
                  <a href="/admin/subject-offerings/<%= o.id %>/edit" class="btn-ghost text-xs">Edit</a>
                  <button type="submit" formaction="/admin/subject-offerings/<%= o.id %>/toggle" class="btn-ghost text-xs"><%= o.isActive ? 'Deactivate' : 'Activate' %></button>
                  <button type="submit" formaction="/admin/subject-offerings/<%= o.id %>/delete" class="btn-ghost text-xs !text-amber-700" onclick="return confirm('Delete this subject offering?');">Delete</button>
                </div>
              </td>
            </tr>
          <% }) %>
          <% if (!offerings.length) { %><tr><td colspan="8" class="py-4 text-navy-400">No subject offerings yet.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </form>
</div>
