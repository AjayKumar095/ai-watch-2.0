<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-navy-900">Certificates</h1>
  <a href="/admin/certificates/new" class="btn-primary">+ Generate Certificate</a>
</div>
<div class="card">
  <table class="min-w-full divide-y divide-navy-100 text-sm">
    <thead><tr class="text-left text-xs font-medium uppercase tracking-wide text-navy-400">
      <th class="py-2 pr-3">Student</th><th class="py-2 pr-3">Program</th><th class="py-2 pr-3">Semester</th><th class="py-2 pr-3">Session</th><th class="py-2 pr-3">Code</th><th class="py-2 pr-3">Issued</th>
    </tr></thead>
    <tbody class="divide-y divide-navy-50">
      <% certificates.forEach(function(c) { %>
        <tr>
          <td class="py-2 pr-3 font-medium text-navy-800"><%= c.StudentProfile.User.firstName %> <%= c.StudentProfile.User.lastName %></td>
          <td class="py-2 pr-3 text-navy-500"><%= c.Program.name %></td>
          <td class="py-2 pr-3 text-navy-500"><%= c.semesterNumber %></td>
          <td class="py-2 pr-3 text-navy-500"><%= c.AcademicSession.label %></td>
          <td class="py-2 pr-3 font-mono text-xs text-navy-500"><%= c.verificationCode %></td>
          <td class="py-2 pr-3 text-navy-400"><%= new Date(c.issuedAt).toLocaleDateString() %></td>
        </tr>
      <% }) %>
      <% if (!certificates.length) { %><tr><td colspan="6" class="py-4 text-navy-400">No certificates issued yet.</td></tr><% } %>
    </tbody>
  </table>
</div>
