<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-navy-900">Students</h1>
  <span class="text-xs text-navy-400"><%= students.length %> shown (max 300)</span>
</div>

<div class="card mb-4">
  <form action="/admin/students" method="GET" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-6">
    <div>
      <label class="form-label !mb-1 text-xs">School</label>
      <select class="form-input !py-1.5 text-sm" name="schoolId" onchange="this.form.submit()">
        <option value="">All schools</option>
        <% schools.forEach(function(s) { %><option value="<%= s.id %>" <%= filters.schoolId === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %>
      </select>
    </div>
    <div>
      <label class="form-label !mb-1 text-xs">Program</label>
      <select class="form-input !py-1.5 text-sm" name="programId" onchange="this.form.submit()">
        <option value="">All programs</option>
        <% programs.forEach(function(p) { %><option value="<%= p.id %>" <%= filters.programId === p.id ? 'selected' : '' %>><%= p.name %></option><% }) %>
      </select>
    </div>
    <div>
      <label class="form-label !mb-1 text-xs">Section</label>
      <select class="form-input !py-1.5 text-sm" name="sectionId" onchange="this.form.submit()">
        <option value="">All sections</option>
        <% sections.forEach(function(s) { %><option value="<%= s.id %>" <%= filters.sectionId === s.id ? 'selected' : '' %>>Section <%= s.name %></option><% }) %>
      </select>
    </div>
    <div>
      <label class="form-label !mb-1 text-xs">Sub-Group</label>
      <select class="form-input !py-1.5 text-sm" name="subGroupId" onchange="this.form.submit()" <%= !filters.sectionId ? 'disabled' : '' %>>
        <option value="">All / none</option>
        <% subGroups.forEach(function(g) { %><option value="<%= g.id %>" <%= filters.subGroupId === g.id ? 'selected' : '' %>><%= g.name %></option><% }) %>
      </select>
    </div>
    <div>
      <label class="form-label !mb-1 text-xs">Semester</label>
      <select class="form-input !py-1.5 text-sm" name="semesterNumber" onchange="this.form.submit()">
        <option value="">All semesters</option>
        <% for (let n = 1; n <= 10; n++) { %><option value="<%= n %>" <%= String(filters.semesterNumber) === String(n) ? 'selected' : '' %>>Semester <%= n %></option><% } %>
      </select>
    </div>
    <div>
      <label class="form-label !mb-1 text-xs">Search</label>
      <div class="flex gap-1">
        <input class="form-input !py-1.5 text-sm" type="text" name="search" placeholder="Name, roll no, email" value="<%= filters.search || '' %>" />
        <button type="submit" class="btn-secondary !px-3 !py-1.5 text-xs">Go</button>
      </div>
    </div>
  </form>
  <% if (filters.schoolId || filters.programId || filters.sectionId || filters.subGroupId || filters.semesterNumber || filters.search) { %>
    <a href="/admin/students" class="mt-3 inline-block text-xs text-info-600 hover:underline">Clear all filters</a>
  <% } %>
</div>

<div class="card">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-navy-100 text-sm">
      <thead><tr class="text-left text-xs font-medium uppercase tracking-wide text-navy-400">
        <th class="py-2 pr-3">Roll No</th><th class="py-2 pr-3">Name</th><th class="py-2 pr-3">Program</th>
        <th class="py-2 pr-3">Specialization</th><th class="py-2 pr-3">Section</th><th class="py-2 pr-3">Sem</th>
        <th class="py-2 pr-3">Session</th><th class="py-2 pr-3">Status</th>
      </tr></thead>
      <tbody class="divide-y divide-navy-50">
        <% students.forEach(function(s) { %>
          <tr>
            <td class="py-2 pr-3 font-mono text-xs text-navy-500"><%= s.rollNo %></td>
            <td class="py-2 pr-3 font-medium text-navy-800"><%= s.User.firstName %> <%= s.User.lastName %></td>
            <td class="py-2 pr-3 text-navy-500"><%= s.Program.name %></td>
            <td class="py-2 pr-3 text-navy-500"><%= s.Specialization ? s.Specialization.name : '—' %></td>
            <td class="py-2 pr-3 text-navy-500"><%= s.currentSection ? s.currentSection.name : '—' %></td>
            <td class="py-2 pr-3 text-navy-500"><%= s.currentSemesterNumber %></td>
            <td class="py-2 pr-3 text-navy-400"><%= s.AcademicSession ? s.AcademicSession.label : '—' %></td>
            <td class="py-2 pr-3">
              <% if (s.status === 'GRADUATED') { %><span class="badge-navy">Graduated</span>
              <% } else if (!s.isVerified) { %><span class="badge-amber">Pending</span>
              <% } else { %><span class="badge-info">Active</span><% } %>
            </td>
          </tr>
        <% }) %>
        <% if (!students.length) { %><tr><td colspan="8" class="py-4 text-navy-400">No students match these filters.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
