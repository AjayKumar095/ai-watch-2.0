<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-navy-900">Superadmin Dashboard</h1>
    <p class="text-sm text-navy-500">Full control over academic structure, people, and system data.</p>
  </div>
  <a href="/admin/teachers/new" class="btn-primary">+ Create Teacher</a>
</div>

<div class="mb-6 flex flex-wrap gap-3">
  <a href="/admin/mappings/new" class="btn-secondary">+ Map Teacher to Subject</a>
  <a href="/admin/enroll" class="btn-secondary">+ Enroll Students</a>
</div>

<div class="grid grid-cols-1 gap-4 sm:grid-cols-3 lg:grid-cols-6">
  <div class="card"><p class="text-xs uppercase text-navy-400">Schools</p><p class="mt-2 text-2xl font-bold text-navy-900"><%= stats.schoolCount %></p></div>
  <div class="card"><p class="text-xs uppercase text-navy-400">Programs</p><p class="mt-2 text-2xl font-bold text-navy-900"><%= stats.programCount %></p></div>
  <div class="card"><p class="text-xs uppercase text-navy-400">Subjects</p><p class="mt-2 text-2xl font-bold text-navy-900"><%= stats.subjectCount %></p></div>
  <div class="card"><p class="text-xs uppercase text-navy-400">Sessions</p><p class="mt-2 text-2xl font-bold text-navy-900"><%= stats.sessionCount %></p></div>
  <div class="card"><p class="text-xs uppercase text-navy-400">Teachers</p><p class="mt-2 text-2xl font-bold text-info-600"><%= stats.teacherCount %></p></div>
  <div class="card"><p class="text-xs uppercase text-navy-400">Students</p><p class="mt-2 text-2xl font-bold text-amber-600"><%= stats.studentCount %></p></div>
</div>

<div class="card mt-6">
  <h2 class="mb-3 text-lg font-semibold text-navy-900">Academic Structure</h2>
  <div class="grid grid-cols-1 gap-2 text-sm sm:grid-cols-3">
    <a href="/admin/schools" class="btn-secondary justify-start">Schools</a>
    <a href="/admin/programs" class="btn-secondary justify-start">Programs & Specializations</a>
    <a href="/admin/sessions" class="btn-secondary justify-start">Academic Sessions</a>
    <a href="/admin/offerings" class="btn-secondary justify-start">Program Offerings</a>
    <a href="/admin/sections" class="btn-secondary justify-start">Sections & Sub-Groups</a>
    <a href="/admin/subjects" class="btn-secondary justify-start">Subject Pool</a>
    <a href="/admin/subject-offerings" class="btn-secondary justify-start">Subject Offerings</a>
    <a href="/admin/mappings" class="btn-secondary justify-start">Teacher Mappings</a>
    <a href="/admin/enroll" class="btn-secondary justify-start">Enroll Students</a>
  </div>
</div>

<div class="card mt-6">
  <h2 class="mb-3 text-lg font-semibold text-navy-900">Term Rollover & Records</h2>
  <div class="grid grid-cols-1 gap-2 text-sm sm:grid-cols-2">
    <a href="/admin/session-clone" class="btn-secondary justify-start">Clone Academic Session Forward</a>
    <a href="/admin/promotions" class="btn-secondary justify-start">Promotion Batches</a>
    <a href="/admin/certificates" class="btn-secondary justify-start">Certificates</a>
    <a href="/admin/audit-log" class="btn-secondary justify-start">Audit Log</a>
  </div>
</div>
