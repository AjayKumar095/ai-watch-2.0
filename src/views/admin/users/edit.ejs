<div class="mx-auto mt-4 max-w-lg">
  <div class="card">
    <h1 class="text-xl font-bold text-navy-900">Edit User</h1>
    <p class="mt-1 text-xs text-navy-400">
      This edits the account itself. Role-specific details (employee code, roll number, program, etc.) are
      managed from <a href="/admin/teachers" class="text-info-600 hover:underline">Teachers</a> or
      <a href="/admin/students" class="text-info-600 hover:underline">Students</a>.
    </p>
    <% if (error) { %><div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= error %></div><% } %>

    <form action="/admin/users/<%= user.id %>/edit" method="POST" class="mt-6 space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div><label class="form-label">First name</label><input class="form-input" name="firstName" value="<%= user.firstName %>" required /></div>
        <div><label class="form-label">Last name</label><input class="form-input" name="lastName" value="<%= user.lastName %>" required /></div>
      </div>
      <div><label class="form-label">Email</label><input class="form-input" type="email" name="email" value="<%= user.email %>" required /></div>
      <div>
        <label class="form-label">Role</label>
        <input class="form-input" value="<%= user.role %>" disabled />
        <p class="mt-1 text-xs text-navy-400">Role can't be changed here — it would leave the account without the matching profile record.</p>
      </div>
      <label class="flex items-center gap-2 text-sm text-navy-700">
        <input type="checkbox" name="isActive" <%= user.isActive ? 'checked' : '' %> /> Account active (can log in)
      </label>
      <button type="submit" class="btn-primary w-full">Save changes</button>
    </form>

    <form action="/admin/users/<%= user.id %>/delete" method="POST" class="mt-3" onsubmit="return confirm('Delete this user account? This cannot be undone.');">
      <button type="submit" class="btn-secondary w-full !border-amber-300 !text-amber-700 hover:!bg-amber-50">Delete user</button>
    </form>
  </div>
</div>
