<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-navy-900">Users</h1>
  <span class="text-xs text-navy-400">
    <% if (pagination.totalCount > 0) { %>
      Showing <%= (pagination.page - 1) * pagination.pageSize + 1 %>–<%= Math.min(pagination.page * pagination.pageSize, pagination.totalCount) %>
      of <%= pagination.totalCount %>
    <% } else { %>
      0 users
    <% } %>
  </span>
</div>

<form method="GET" action="/admin/users" class="card mb-4 flex flex-wrap items-end gap-3">
  <div>
    <label class="form-label">Search</label>
    <input class="form-input" type="text" name="search" value="<%= filters.search || '' %>" placeholder="Name or email" />
  </div>
  <div>
    <label class="form-label">Role</label>
    <select class="form-input" name="role" onchange="this.form.submit()">
      <option value="">All roles</option>
      <option value="SUPERADMIN" <%= filters.role === 'SUPERADMIN' ? 'selected' : '' %>>Superadmin</option>
      <option value="TEACHER" <%= filters.role === 'TEACHER' ? 'selected' : '' %>>Teacher</option>
      <option value="STUDENT" <%= filters.role === 'STUDENT' ? 'selected' : '' %>>Student</option>
    </select>
  </div>
  <div>
    <label class="form-label">Status</label>
    <select class="form-input" name="status" onchange="this.form.submit()">
      <option value="">All statuses</option>
      <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
      <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
    </select>
  </div>
  <button type="submit" class="btn-primary">Filter</button>
  <% if (filters.role || filters.status || filters.search) { %><a href="/admin/users" class="btn-ghost text-sm">Clear</a><% } %>
</form>

<div class="card">
  <table class="min-w-full divide-y divide-navy-100 text-sm">
    <thead><tr class="text-left text-xs font-medium uppercase tracking-wide text-navy-400">
      <th class="py-2 pr-3">Name</th><th class="py-2 pr-3">Email</th><th class="py-2 pr-3">Role</th><th class="py-2 pr-3">Detail</th><th class="py-2 pr-3">Status</th><th class="py-2 pr-3"></th>
    </tr></thead>
    <tbody class="divide-y divide-navy-50">
      <% users.forEach(function(u) { %>
        <tr>
          <td class="py-2 pr-3 font-medium text-navy-800"><%= u.fullName() %></td>
          <td class="py-2 pr-3 text-navy-500"><%= u.email %></td>
          <td class="py-2 pr-3">
            <span class="<%= u.role === 'SUPERADMIN' ? 'badge-navy' : (u.role === 'TEACHER' ? 'badge-amber' : 'badge-info') %>"><%= u.role %></span>
          </td>
          <td class="py-2 pr-3 text-navy-500">
            <% if (u.TeacherProfile) { %><%= u.TeacherProfile.employeeCode %><% if (u.TeacherProfile.School) { %> · <%= u.TeacherProfile.School.name %><% } %>
            <% } else if (u.StudentProfile) { %><%= u.StudentProfile.rollNo %><% if (u.StudentProfile.Program) { %> · <%= u.StudentProfile.Program.name %><% } %>
            <% } else { %>—<% } %>
          </td>
          <td class="py-2 pr-3"><span class="<%= u.isActive ? 'badge-info' : 'badge-amber' %>"><%= u.isActive ? 'Active' : 'Inactive' %></span></td>
          <td class="py-2 pr-3"><a href="/admin/users/<%= u.id %>/edit" class="btn-ghost text-xs">Edit</a></td>
        </tr>
      <% }) %>
      <% if (!users.length) { %><tr><td colspan="6" class="py-4 text-navy-400">No users match this filter.</td></tr><% } %>
    </tbody>
  </table>
</div>

<% if (pagination.totalPages > 1) { %>
  <% var qs = pagination.filterQueryString ? pagination.filterQueryString + '&' : ''; %>
  <div class="mt-4 flex items-center justify-center gap-1 text-sm">
    <% if (pagination.page > 1) { %>
      <a href="?<%= qs %>page=<%= pagination.page - 1 %>" class="btn-secondary !px-3 !py-1.5 text-xs">← Prev</a>
    <% } else { %>
      <span class="btn-secondary !px-3 !py-1.5 text-xs opacity-40">← Prev</span>
    <% } %>

    <%
      var pages = [];
      for (var p = 1; p <= pagination.totalPages; p++) {
        if (p === 1 || p === pagination.totalPages || Math.abs(p - pagination.page) <= 2) pages.push(p);
      }
    %>
    <% var lastShown = 0; %>
    <% pages.forEach(function(p) { %>
      <% if (p - lastShown > 1) { %><span class="px-1 text-navy-300">…</span><% } %>
      <% if (p === pagination.page) { %>
        <span class="rounded-lg bg-amber-500 px-3 py-1.5 text-xs font-medium text-white"><%= p %></span>
      <% } else { %>
        <a href="?<%= qs %>page=<%= p %>" class="rounded-lg px-3 py-1.5 text-xs font-medium text-navy-600 hover:bg-navy-50"><%= p %></a>
      <% } %>
      <% lastShown = p; %>
    <% }) %>

    <% if (pagination.page < pagination.totalPages) { %>
      <a href="?<%= qs %>page=<%= pagination.page + 1 %>" class="btn-secondary !px-3 !py-1.5 text-xs">Next →</a>
    <% } else { %>
      <span class="btn-secondary !px-3 !py-1.5 text-xs opacity-40">Next →</span>
    <% } %>
  </div>
<% } %>
