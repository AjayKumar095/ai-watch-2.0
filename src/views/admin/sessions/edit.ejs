<div class="mx-auto mt-4 max-w-lg">
  <div class="card">
    <h1 class="text-xl font-bold text-navy-900">Edit Academic Session</h1>
    <% if (error) { %><div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= error %></div><% } %>
    <form action="/admin/sessions/<%= session.id %>/edit" method="POST" class="mt-6 space-y-4">
      <div><label class="form-label">Label</label><input class="form-input" name="label" value="<%= session.label %>" required /></div>
      <div class="grid grid-cols-2 gap-4">
        <div><label class="form-label">Start date</label><input class="form-input" type="date" name="startDate" value="<%= session.startDate.toISOString().slice(0,10) %>" required /></div>
        <div><label class="form-label">End date</label><input class="form-input" type="date" name="endDate" value="<%= session.endDate.toISOString().slice(0,10) %>" required /></div>
      </div>
      <button type="submit" class="btn-primary w-full">Save changes</button>
    </form>
    <form action="/admin/sessions/<%= session.id %>/toggle" method="POST" class="mt-3">
      <button class="btn-secondary w-full"><%= session.isActive ? 'Deactivate' : 'Activate' %></button>
    </form>
    <form action="/admin/sessions/<%= session.id %>/delete" method="POST" class="mt-3" onsubmit="return confirm('Delete this session? This cannot be undone.');">
      <button type="submit" class="btn-secondary w-full !border-amber-300 !text-amber-700 hover:!bg-amber-50">Delete session</button>
    </form>
  </div>
</div>
