<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-navy-900">Academic Sessions</h1>
  <a href="/admin/sessions/new" class="btn-primary">+ Add Session</a>
</div>
<div class="card">
  <table class="min-w-full divide-y divide-navy-100 text-sm">
    <thead><tr class="text-left text-xs font-medium uppercase tracking-wide text-navy-400">
      <th class="py-2 pr-3">Label</th><th class="py-2 pr-3">Start</th><th class="py-2 pr-3">End</th><th class="py-2 pr-3">Status</th>
    </tr></thead>
    <tbody class="divide-y divide-navy-50">
      <% sessions.forEach(function(s) { %>
        <tr>
          <td class="py-2 pr-3 font-medium text-navy-800"><%= s.label %></td>
          <td class="py-2 pr-3 text-navy-500"><%= new Date(s.startDate).toLocaleDateString() %></td>
          <td class="py-2 pr-3 text-navy-500"><%= new Date(s.endDate).toLocaleDateString() %></td>
          <td class="py-2 pr-3"><span class="<%= s.isActive ? 'badge-info' : 'badge-amber' %>"><%= s.isActive ? 'Active' : 'Inactive' %></span></td>
        </tr>
      <% }) %>
      <% if (!sessions.length) { %><tr><td colspan="4" class="py-4 text-navy-400">No sessions yet.</td></tr><% } %>
    </tbody>
  </table>
</div>
