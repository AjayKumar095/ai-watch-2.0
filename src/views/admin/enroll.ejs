<div class="mx-auto mt-4 max-w-lg">
  <div class="card">
    <h1 class="text-xl font-bold text-navy-900">Enroll Students (default rule)</h1>
    <p class="mt-1 text-sm text-navy-500">
      Auto-enrolls all students matching this offering's program + semester + specialization.
      Manual add/remove for mixed-specialization exceptions comes next.
    </p>

    <% if (result) { %>
      <div class="mt-4 rounded-lg border border-info-200 bg-info-50 px-3 py-2 text-sm text-info-800">
        <%= result.offeringName %>: <%= result.created %> newly enrolled, <%= result.skipped %> already enrolled
        (<%= result.total %> matching students total).
      </div>
    <% } %>

    <form action="/admin/enroll/auto" method="POST" class="mt-6 space-y-4">
      <div>
        <label class="form-label">Subject Offering</label>
        <select class="form-input" name="subjectOfferingId" required>
          <option value="">Select a subject offering</option>
          <% offerings.forEach(function(o) { %>
            <option value="<%= o.id %>"><%= o.SubjectPool.name %> — <%= o.Program.name %> Sem <%= o.semesterNumber %></option>
          <% }) %>
        </select>
      </div>
      <button type="submit" class="btn-primary w-full">Run auto-enroll</button>
    </form>
  </div>
</div>
