<div class="mb-6">
  <h1 class="text-xl font-bold text-navy-900">My Certificates</h1>
  <p class="mt-1 text-sm text-navy-500">Track your evaluation progress per semester and download certificates once they're issued.</p>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= error %></div>
<% } %>

<!-- Tabs -->
<div class="mb-6 flex gap-1 border-b border-navy-100">
  <a href="?tab=progress"
     class="flex items-center gap-1.5 px-4 py-2 text-sm font-medium <%= activeTab === 'progress' ? 'border-b-2 border-amber-500 text-navy-900' : 'text-navy-400 hover:text-navy-600' %>">
    <i class="fa-solid fa-chart-line"></i> Progress
    <% if (progress.length) { %><span class="text-xs text-navy-300">(<%= progress.length %>)</span><% } %>
  </a>
  <a href="?tab=certificates"
     class="flex items-center gap-1.5 px-4 py-2 text-sm font-medium <%= activeTab === 'certificates' ? 'border-b-2 border-amber-500 text-navy-900' : 'text-navy-400 hover:text-navy-600' %>">
    <i class="fa-solid fa-certificate"></i> Issued Certificates
    <% if (certificates.length) { %><span class="text-xs text-navy-300">(<%= certificates.length %>)</span><% } %>
  </a>
</div>

<% if (activeTab === 'progress') { %>
  <% if (!progress.length) { %>
    <div class="rounded-xl border border-dashed border-navy-200 bg-white px-6 py-10 text-center">
      <i class="fa-solid fa-book-open mb-3 text-2xl text-navy-200"></i>
      <p class="text-sm font-medium text-navy-600">No enrollments found yet</p>
      <p class="mt-1 text-xs text-navy-400">Once you're enrolled in a subject, its progress will show up here.</p>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      <% progress.forEach(function(p) {
           var pct = p.totalAssessments ? Math.round((p.evaluatedCount / p.totalAssessments) * 100) : 0;
           var state = p.issued ? 'issued' : (p.eligible ? 'pending' : 'locked');
      %>
        <div class="relative overflow-hidden rounded-xl border border-navy-100 bg-white shadow-sm transition hover:shadow-md">
          <div class="absolute inset-y-0 left-0 w-1
            <%= state === 'issued' ? 'bg-teal-500' : state === 'pending' ? 'bg-amber-400' : 'bg-navy-200' %>"></div>

          <div class="p-5 pl-6">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-navy-900"><%= p.programName %></p>
                <p class="mt-0.5 text-xs text-navy-400">Semester <%= p.semesterNumber %> · Admitted <%= p.admissionYear %></p>
                <% if (p.levelDisplay) { %>
                  <span class="mt-1.5 inline-block rounded-full bg-navy-50 px-2 py-0.5 text-xs font-medium text-navy-500"><%= p.levelDisplay %></span>
                <% } %>
              </div>

              <% if (state === 'issued') { %>
                <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-teal-50 px-2.5 py-1 text-xs font-medium text-teal-700">
                  <i class="fa-solid fa-circle-check"></i> Issued
                </span>
              <% } else if (state === 'pending') { %>
                <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700">
                  <i class="fa-solid fa-hourglass-half"></i> Pending
                </span>
              <% } else { %>
                <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-navy-50 px-2.5 py-1 text-xs font-medium text-navy-400">
                  <i class="fa-solid fa-lock"></i> Locked
                </span>
              <% } %>
            </div>

            <!-- Progress bar: assessments evaluated -->
            <div class="mt-4">
              <div class="mb-1.5 flex items-baseline justify-between text-xs">
                <span class="text-navy-500">Assessments evaluated</span>
                <span class="font-semibold text-navy-700"><%= p.evaluatedCount %> / <%= p.totalAssessments %></span>
              </div>
              <div class="h-2 w-full overflow-hidden rounded-full bg-navy-100 ring-1 ring-inset ring-navy-100">
                <div class="h-2 rounded-full transition-all <%= state === 'issued' ? 'bg-teal-500' : 'bg-amber-400' %>"
                     style="width: <%= Math.max(pct, pct > 0 ? 4 : 0) %>%"></div>
              </div>
            </div>

            <!-- Status detail -->
            <div class="mt-4 rounded-lg p-3
              <%= state === 'issued' ? 'bg-teal-50/70' : state === 'pending' ? 'bg-amber-50/70' : 'bg-navy-50' %>">
              <% if (state === 'issued') { %>
                <div class="flex items-center justify-between gap-3">
                  <p class="text-xs font-medium text-teal-800">Certificate ready</p>
                  <a href="/student/certificates/<%= p.certificateId %>/download" target="_blank"
                     class="inline-flex items-center gap-1.5 rounded-lg bg-amber-500 px-3 py-1.5 text-xs font-semibold text-navy-900 transition hover:bg-amber-400">
                    <i class="fa-solid fa-download"></i> Download
                  </a>
                </div>
              <% } else if (state === 'pending') { %>
                <p class="text-xs font-medium text-amber-800">
                  <i class="fa-solid fa-check mr-1"></i>All requirements met — your certificate is being issued.
                </p>
              <% } else { %>
                <p class="text-xs font-medium text-navy-600"><%= p.reason %></p>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
<% } else { %>
  <% if (!certificates.length) { %>
    <div class="rounded-xl border border-dashed border-navy-200 bg-white px-6 py-10 text-center">
      <i class="fa-solid fa-certificate mb-3 text-2xl text-navy-200"></i>
      <p class="text-sm font-medium text-navy-600">No certificates issued yet</p>
      <p class="mt-1 text-xs text-navy-400">Check the Progress tab to see what's still pending.</p>
    </div>
  <% } else { %>
    <div class="overflow-hidden rounded-xl border border-navy-100 bg-white">
      <table class="w-full text-sm">
        <thead class="bg-navy-50 text-left text-xs font-semibold uppercase tracking-wide text-navy-500">
          <tr>
            <th class="px-4 py-3">Program</th>
            <th class="px-4 py-3">Semester</th>
            <th class="px-4 py-3">Level</th>
            <th class="px-4 py-3">Verification Code</th>
            <th class="px-4 py-3">Issued</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-navy-50">
          <% certificates.forEach(function(c) { %>
            <tr class="transition hover:bg-navy-50/60">
              <td class="px-4 py-3 font-medium text-navy-900"><%= c.Program ? c.Program.name : '—' %></td>
              <td class="px-4 py-3 text-navy-600">Sem <%= c.semesterNumber %> · <%= c.admissionYear %></td>
              <td class="px-4 py-3">
                <% if (c.levelDisplay) { %>
                  <span class="inline-block rounded-full bg-navy-50 px-2 py-0.5 text-xs font-medium text-navy-500"><%= c.levelDisplay %></span>
                <% } else { %>
                  <span class="text-navy-400">—</span>
                <% } %>
              </td>
              <td class="px-4 py-3 font-mono text-xs text-navy-500"><%= c.verificationCode %></td>
              <td class="px-4 py-3 text-navy-500"><%= new Date(c.issuedAt).toLocaleDateString() %></td>
              <td class="px-4 py-3 text-right">
                <a href="/student/certificates/<%= c.id %>/download" target="_blank"
                   class="inline-flex items-center gap-1.5 rounded-lg bg-amber-500 px-3 py-1.5 text-xs font-semibold text-navy-900 transition hover:bg-amber-400">
                  <i class="fa-solid fa-download"></i>Download
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
<% } %>
