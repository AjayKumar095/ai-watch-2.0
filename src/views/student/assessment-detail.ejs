<div class="mx-auto mt-4 max-w-5xl">
  <a href="/student/dashboard" class="mb-4 inline-flex items-center gap-1.5 text-xs text-navy-400 hover:text-info-600 hover:underline">
    <i class="fa-solid fa-arrow-left"></i> Back to dashboard
  </a>

  <div class="mt-3 grid grid-cols-1 gap-6 lg:grid-cols-3">
    <!-- Main column: title + full content, given real room to breathe -->
    <div class="space-y-4 lg:col-span-2">
      <div class="card">
        <h1 class="text-2xl font-bold text-navy-900"><%= assessment.title %></h1>
        <p class="mt-1 text-sm text-navy-500"><%= assessment.SubjectOffering.SubjectPool.name %></p>

        <% if (existingSubmission && existingSubmission.status === 'EVALUATED') { %>
          <div class="mt-4 rounded-lg border border-info-200 bg-info-50 px-3 py-2 text-sm text-info-800">
            Evaluated: <strong><%= existingSubmission.marksObtained %>/<%= assessment.maxMarks %></strong>
            <% if (existingSubmission.remarks) { %> — <%= existingSubmission.remarks %><% } %>
          </div>
        <% } %>
      </div>

      <div class="card">
        <h2 class="mb-4 text-xs font-semibold uppercase tracking-wide text-navy-400">Assessment Content</h2>
        <% if (descriptionHtml) { %>
          <div class="prose-content"><%- descriptionHtml %></div>
        <% } else { %>
          <p class="text-sm text-navy-400">No additional content was added for this assessment.</p>
        <% } %>
      </div>
    </div>

    <!-- Sidebar: meta + submission form, sticky so it stays visible while reading long content -->
    <div class="space-y-4 lg:sticky lg:top-4 lg:self-start">
      <div class="card">
        <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-navy-400">Details</h2>
        <dl class="space-y-2.5 text-sm">
          <div class="flex items-center justify-between">
            <dt class="text-navy-500">Max marks</dt>
            <dd class="font-medium text-navy-800"><%= assessment.maxMarks %></dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-navy-500">Opens</dt>
            <dd class="text-right font-medium text-navy-800"><%= new Date(assessment.startAt).toLocaleString() %></dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-navy-500">Closes</dt>
            <dd class="text-right font-medium text-navy-800"><%= new Date(assessment.endAt).toLocaleString() %></dd>
          </div>
          <% if (assessment.attachmentUrl) { %>
            <div class="flex items-center justify-between">
              <dt class="text-navy-500">Attachment</dt>
              <dd><a href="<%= assessment.attachmentUrl %>" target="_blank" rel="noopener" class="font-medium text-info-600 hover:underline">Open <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i></a></dd>
            </div>
          <% } %>
        </dl>
      </div>

      <div class="card">
        <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-navy-400">
          <%= existingSubmission ? 'Your Submission' : 'Submit Your Work' %>
        </h2>

        <% if (error) { %>
          <div class="mb-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= error %></div>
        <% } %>

        <% if (existingSubmission && Array.isArray(existingSubmission.attachments) && existingSubmission.attachments.length) { %>
          <div class="mb-3 rounded-lg border border-navy-100 bg-navy-50 px-3 py-2">
            <p class="mb-1 text-xs font-medium text-navy-500">Currently attached:</p>
            <ul class="space-y-0.5 text-xs">
              <% existingSubmission.attachments.forEach(function(att) { %>
                <li>
                  <a href="<%= att.url %>" target="_blank" rel="noopener" class="text-info-600 hover:underline"><%= att.originalName %></a>
                  <span class="text-navy-400">(<%= (att.size / (1024 * 1024)).toFixed(2) %> MB)</span>
                </li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form
          id="submission-form"
          action="/student/assessments/<%= assessment.id %>/submit"
          method="POST"
          enctype="multipart/form-data"
          class="space-y-4"
        >
          <div>
            <label class="form-label">Submission link (Drive/GitHub/etc.)</label>
            <input class="form-input" name="url" value="<%= existingSubmission ? existingSubmission.url || '' : '' %>" placeholder="https://..." />
          </div>
          <div>
            <label class="form-label">Notes</label>
            <textarea class="form-input" name="description" rows="4"><%= existingSubmission ? existingSubmission.description || '' : '' %></textarea>
          </div>
          <div>
            <label class="form-label">Attach files (PDF, Word, PowerPoint — 5MB combined max)</label>
            <input
              id="submission-attachments"
              class="form-input !py-2 text-sm"
              type="file"
              name="attachments"
              multiple
              accept=".pdf,.doc,.docx,.ppt,.pptx"
            />
            <p id="attachments-hint" class="mt-1 text-xs text-navy-400">Uploading new files replaces any currently attached ones.</p>
          </div>
          <button type="submit" id="submit-btn" class="btn-primary w-full"><%= existingSubmission ? 'Update submission' : 'Submit' %></button>
        </form>
      </div>
    </div>

    <script>
      (function () {
        var form = document.getElementById('submission-form');
        var fileInput = document.getElementById('submission-attachments');
        var hint = document.getElementById('attachments-hint');
        var submitBtn = document.getElementById('submit-btn');
        var MAX_TOTAL_BYTES = 5 * 1024 * 1024;
        var ALLOWED_EXTENSIONS = ['.pdf', '.doc', '.docx', '.ppt', '.pptx'];
        var hasExistingSubmission = <%- JSON.stringify(!!existingSubmission) %>;
        var wasEvaluated = <%- JSON.stringify(!!(existingSubmission && existingSubmission.status === 'EVALUATED')) %>;

        function extOf(name) {
          var i = name.lastIndexOf('.');
          return i === -1 ? '' : name.slice(i).toLowerCase();
        }

        // Client-side validation is instant feedback only — the server
        // (middleware/submissionUpload.js + studentController.submitAssessment)
        // re-validates both the extension allow-list and the combined 5MB
        // limit regardless of what happens here.
        fileInput.addEventListener('change', function () {
          var files = Array.prototype.slice.call(fileInput.files);
          var total = files.reduce(function (sum, f) { return sum + f.size; }, 0);
          var badFile = files.find(function (f) { return ALLOWED_EXTENSIONS.indexOf(extOf(f.name)) === -1; });

          if (badFile) {
            hint.textContent = '"' + badFile.name + '" isn\'t an allowed type — only PDF, Word, and PowerPoint files are accepted.';
            hint.classList.add('text-amber-600');
            fileInput.setCustomValidity('Remove or replace the disallowed file.');
            return;
          }
          if (total > MAX_TOTAL_BYTES) {
            hint.textContent = 'Total ' + (total / (1024 * 1024)).toFixed(1) + 'MB — the combined limit is 5MB.';
            hint.classList.add('text-amber-600');
            fileInput.setCustomValidity('Files exceed the 5MB combined limit.');
            return;
          }

          fileInput.setCustomValidity('');
          hint.classList.remove('text-amber-600');
          hint.textContent = files.length
            ? files.length + ' file(s) selected, ' + (total / (1024 * 1024)).toFixed(2) + 'MB total.'
            : 'Uploading new files replaces any currently attached ones.';
        });

        form.addEventListener('submit', function (e) {
          if (hasExistingSubmission) {
            var message = wasEvaluated
              ? 'Resubmitting will delete your previous submission and its file(s), AND clear the marks/remarks already given for it. Continue?'
              : 'Resubmitting will replace your previous submission and its file(s). Continue?';
            if (!confirm(message)) {
              e.preventDefault();
              return;
            }
          }

          // Disable + relabel to prevent a double submit while the
          // (potentially slow, file-upload) request is in flight.
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting…';
        });
      })();
    </script>
  </div>
</div>

<style>
  /* Readable typography for BlockNote-rendered content (renderBlocks.js
     output) — scoped to .prose-content so it only affects assessment/blog
     bodies, not the rest of the app's UI chrome. */
  .prose-content {
    font-size: 0.975rem;
    line-height: 1.75;
    color: var(--color-navy-700, #33415c);
    word-break: break-word;
  }
  .prose-content > *:first-child { margin-top: 0; }
  .prose-content h1, .prose-content h2, .prose-content h3,
  .prose-content h4, .prose-content h5, .prose-content h6 {
    font-weight: 700;
    color: var(--color-navy-900, #0f1729);
    margin-top: 1.5em;
    margin-bottom: 0.5em;
    line-height: 1.3;
  }
  .prose-content h1 { font-size: 1.5rem; }
  .prose-content h2 { font-size: 1.25rem; }
  .prose-content h3 { font-size: 1.1rem; }
  .prose-content p { margin: 0 0 1em; }
  .prose-content ul, .prose-content ol { margin: 0 0 1em 1.25rem; }
  .prose-content ul { list-style: disc; }
  .prose-content ol { list-style: decimal; }
  .prose-content li { margin-bottom: 0.4em; }
  .prose-content a { color: var(--color-info-600, #0284c7); text-decoration: underline; }
  .prose-content img {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin: 1em auto;
    display: block;
  }
  .prose-content figure { margin: 1.25em 0; }
  .prose-content figcaption {
    font-size: 0.8rem;
    color: var(--color-navy-400, #94a3b8);
    text-align: center;
    margin-top: 0.4rem;
  }
  .prose-content pre {
    background: var(--color-navy-900, #0f1729);
    color: #e2e8f0;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1em 0;
    font-size: 0.85rem;
  }
  .prose-content pre code { background: none; padding: 0; color: inherit; }
  .prose-content :not(pre) > code {
    background: var(--color-navy-50, #f1f4f9);
    padding: 0.15em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.85em;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .prose-content blockquote {
    border-left: 3px solid var(--color-teal, #0f9e8f);
    padding-left: 1rem;
    color: var(--color-navy-500, #64748b);
    margin: 1em 0;
    font-style: italic;
  }
  .prose-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1em 0;
    font-size: 0.875rem;
    display: block;
    overflow-x: auto;
  }
  .prose-content td, .prose-content th {
    border: 1px solid var(--color-navy-100, #e2e8f0);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .prose-content hr.rule {
    border: none;
    border-top: 1px solid var(--color-navy-100, #e2e8f0);
    margin: 2rem 0;
  }
  .prose-content details {
    border: 1px solid var(--color-navy-100, #e2e8f0);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    margin: 1em 0;
  }
  .prose-content summary { font-weight: 600; cursor: pointer; }
</style>
