<div class="mx-auto mt-4 max-w-5xl">
  <a href="/student/dashboard"
    class="mb-4 inline-flex items-center gap-1.5 text-xs text-navy-400 hover:text-info-600 hover:underline">
    <i class="fa-solid fa-arrow-left"></i> Back to dashboard
  </a>

  <div class="mt-3 grid grid-cols-1 gap-6 lg:grid-cols-3">
    <!-- Main column: title + full content, given real room to breathe -->
    <div class="space-y-4 lg:col-span-2">
      <div class="card">
        <h1 class="text-2xl font-bold text-navy-900">
          <%= assessment.title %>
        </h1>
        <p class="mt-1 text-sm text-navy-500">
          <%= assessment.SubjectOffering.SubjectPool.name %>
        </p>

        <% if (existingSubmission && existingSubmission.status==='EVALUATED' ) { %>
          <div class="mt-4 rounded-lg border border-info-200 bg-info-50 px-3 py-2 text-sm text-info-800">
            Evaluated: <strong>
              <%= existingSubmission.marksObtained %>/<%= assessment.maxMarks %>
            </strong>
            <% if (existingSubmission.remarks) { %> — <%= existingSubmission.remarks %>
                <% } %>
          </div>
          <% } %>
      </div>

      <div class="card">
        <h2 class="mb-4 text-xs font-semibold uppercase tracking-wide text-navy-400">Assessment Content</h2>
        <% if (descriptionHtml) { %>
          <div class="prose-content"><%- descriptionHtml %></div>
          <% } else { %>
            <p class="text-sm text-navy-400">No additional content was added for this assessment.</p>
            <% } %>
              <% if (assessment.attachmentUrl) { %>
                <div class="flex items-center justify-between">
                  <dt class="text-navy-500">Attachment</dt>
                  <dd><a href="<%= assessment.attachmentUrl %>" target="_blank" rel="noopener"
                      class="font-medium text-info-600 hover:underline">Open <i
                        class="fa-solid fa-arrow-up-right-from-square text-xs"></i></a></dd>
                </div>
                <% } %>
      </div>
    </div>

    <!-- Sidebar: meta + submission form, sticky so it stays visible while reading long content -->
    <div class="space-y-4 lg:sticky lg:top-4 lg:self-start mb-32">
      <div class="card">
        <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-navy-400">Details</h2>
        <dl class="space-y-2.5 text-sm">
          <div class="flex items-center justify-between">
            <dt class="text-navy-500">Max marks</dt>
            <dd class="font-medium text-navy-800">
              <%= assessment.maxMarks %>
            </dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-navy-500">Opens</dt>
            <dd class="text-right font-medium text-navy-800">
              <%= new Date(override && override.startAt ? override.startAt : assessment.startAt).toLocaleString('en-US',
                { timeZone: 'Asia/Kolkata' }) %>
                <% if (override && override.startAt) { %><span class="ml-1 text-xs text-info-600">(extended)</span>
                  <% } %>
            </dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-navy-500">Closes</dt>
            <dd class="text-right font-medium text-navy-800">
              <%= new Date(override && override.endAt ? override.endAt : assessment.endAt).toLocaleString('en-US', {
                timeZone: 'Asia/Kolkata' }) %>
                <% if (override && override.endAt) { %><span class="ml-1 text-xs text-info-600">(extended)</span>
                  <% } %>
            </dd>
          </div>
        </dl>
      </div>

      <div class="card">
        <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-navy-400">
          <%= existingSubmission ? 'Your Submission' : 'Submit Your Work' %>
        </h2>

        <% if (error) { %>
          <div class="mb-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
            <%= error %>
          </div>
          <% } %>
        <% if (typeof notice !== 'undefined' && notice) { %>
          <div class="mb-3 rounded-lg border border-info-200 bg-info-50 px-3 py-2 text-sm text-info-800">
            <%= notice %>
          </div>
        <% } %>

            <% if (existingSubmission) {
                 var subFiles = Array.isArray(existingSubmission.attachments) ? existingSubmission.attachments : [];
                 var subUrl = existingSubmission.url || '';
                 var subUrlOk = /^https?:\/\//i.test(subUrl);
                 var subWhen = existingSubmission.submittedAt
                   ? new Date(existingSubmission.submittedAt).toLocaleString('en-US', { timeZone: 'Asia/Kolkata' }) : null;
            %>
              <div class="mb-4 rounded-lg border border-navy-100 bg-navy-50 p-3" id="submission-summary">
                <div class="flex flex-wrap items-center gap-2">
                  <% if (existingSubmission.status === 'EVALUATED') { %><span class="badge-info">Evaluated</span>
                  <% } else { %><span class="badge-amber">Awaiting evaluation</span><% } %>
                  <% if (existingSubmission.isLate) { %><span class="badge-navy">Late</span><% } %>
                  <% if (subWhen) { %><span class="text-xs text-navy-400">Submitted <%= subWhen %></span><% } %>
                </div>

                <dl class="mt-3 space-y-3 text-sm">
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-wide text-navy-400">Link</dt>
                    <dd class="mt-0.5 break-all">
                      <% if (!subUrl) { %><span class="text-navy-400">No link added</span>
                      <% } else if (subUrlOk) { %>
                        <a href="<%= subUrl %>" target="_blank" rel="noopener noreferrer" class="font-medium text-info-600 hover:underline">
                          <i class="fa-solid fa-link mr-1 text-xs"></i><%= subUrl %>
                        </a>
                      <% } else { %><span class="text-navy-700"><%= subUrl %></span><% } %>
                    </dd>
                  </div>
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-wide text-navy-400">Your notes</dt>
                    <dd class="mt-0.5">
                      <% if (existingSubmission.description) { %>
                        <p class="whitespace-pre-wrap break-words rounded-md border border-navy-100 bg-white px-2.5 py-2 text-navy-700"><%= existingSubmission.description %></p>
                      <% } else { %><span class="text-navy-400">No notes added</span><% } %>
                    </dd>
                  </div>
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-wide text-navy-400">Files</dt>
                    <dd class="mt-0.5">
                      <% if (!subFiles.length) { %><span class="text-navy-400">No files attached</span>
                      <% } else { %>
                        <ul class="space-y-1">
                          <% subFiles.forEach(function(att) { %>
                            <li class="flex items-start gap-1.5">
                              <i class="fa-solid fa-paperclip mt-1 text-xs text-navy-300"></i>
                              <span class="min-w-0">
                                <a href="<%= att.url %>" target="_blank" rel="noopener" class="break-all font-medium text-info-600 hover:underline"><%= att.originalName || 'File' %></a>
                                <span class="text-xs text-navy-400">(<%= ((Number(att.size) || 0) / (1024 * 1024)).toFixed(2) %> MB)</span>
                              </span>
                            </li>
                          <% }) %>
                        </ul>
                      <% } %>
                    </dd>
                  </div>
                </dl>
              </div>
            <% } %>

                <% if (typeof historyOnly !=='undefined' && historyOnly) { %>
                  <div class="rounded-lg border border-navy-100 bg-navy-50 px-3 py-2 text-sm text-navy-600">
                    This assessment was given to your previous section or semester. You can still see your submission
                    and your results here, but it is no longer open for changes.
                  </div>
                  <% } else if (submissionClosed) { %>
                    <div class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
                      The submission window for this assessment has closed. If you need to submit late, ask your teacher
                      to open an exception for you.
                    </div>
                    <% } else if (submissionNotYetOpen) { %>
                      <div class="rounded-lg border border-navy-100 bg-navy-50 px-3 py-2 text-sm text-navy-600">
                        This assessment isn't open for submissions yet.
                      </div>
                      <% } else { %>
                        <form id="submission-form" action="/student/assessments/<%= assessment.id %>/submit"
                          method="POST" enctype="multipart/form-data" class="space-y-4">
                          <div>
                            <label class="form-label">Submission link (Drive/GitHub/etc.)</label>
                            <input class="form-input" type="url" name="url"
                              value="<%= existingSubmission ? existingSubmission.url || '' : '' %>"
                              placeholder="https://..." />
                          </div>
                          <div>
                            <label class="form-label">Notes (Max 500 characters):</label>
                            <textarea class="form-input" name="description" maxlength="500" rows="5"
                              required><%= existingSubmission ? existingSubmission.description || '' : '' %></textarea>
                          </div>
                          <div>
                            <% var curFiles = existingSubmission && Array.isArray(existingSubmission.attachments) ? existingSubmission.attachments : []; %>
                            <% if (curFiles.length) { %>
                              <p class="form-label">Current files</p>
                              <ul class="mb-3 space-y-1 rounded-lg border border-navy-100 bg-navy-50 px-3 py-2 text-sm">
                                <% curFiles.forEach(function(att) { %>
                                  <li>
                                    <label class="flex cursor-pointer items-start gap-2">
                                      <input type="checkbox" class="remove-att mt-1" name="removeAttachments" value="<%= att.url %>" />
                                      <span class="min-w-0 break-all text-navy-700"><%= att.originalName || 'File' %>
                                        <span class="text-xs text-navy-400">(<%= ((Number(att.size) || 0) / (1024 * 1024)).toFixed(2) %> MB)</span>
                                        <span class="ml-1 text-xs text-amber-700">tick to remove</span>
                                      </span>
                                    </label>
                                  </li>
                                <% }) %>
                              </ul>
                            <% } %>
                            <label class="form-label"><%= curFiles.length ? 'Add more files' : 'Attach files' %> (PDF, Word, PowerPoint, Excel, CSV, images — 5MB combined max, up to 5 files)</label>
                            <input id="submission-attachments" class="form-input !py-2 text-sm" type="file"
                              name="attachments" multiple
                              accept=".pdf,.doc,.docx,.ppt,.pptx,.md,.csv,.png,.jpg,.jpeg,.webp,.xlsx" />
                            <p id="attachments-hint" class="mt-1 text-xs text-navy-400"><%= existingSubmission
                              ? 'Your current files stay as they are. New files are added to them; tick "tick to remove" on a file to delete it.'
                              : 'You can attach up to 5 files.' %></p>
                          </div>
                          <button type="submit" id="submit-btn" class="btn-primary w-full">
                            <%= existingSubmission ? 'Update submission' : 'Submit' %>
                          </button>
                        </form>
                        <% } %>
      </div>
    </div>

    <script>
      (function () {
        var form = document.getElementById('submission-form');
        if (!form) return; // window closed/not open — no form was rendered

        var fileInput = document.getElementById('submission-attachments');
        var hint = document.getElementById('attachments-hint');
        var submitBtn = document.getElementById('submit-btn');
        var urlInput = form.elements.url;
        var notesInput = form.elements.description;
        var MAX_TOTAL_BYTES = 5 * 1024 * 1024;
        var MAX_FILES = 5;
        var ALLOWED_EXTENSIONS = ['.pdf', '.doc', '.docx', '.ppt', '.pptx', '.md', '.csv', '.png', '.jpg', '.jpeg', '.webp', '.xlsx'];
        // NOTE: the three values below are printed with the unescaped output tag. A space between the percent sign and the dash silently prints nothing and breaks this whole script.
        var hasExistingSubmission = <%- JSON.stringify(!!existingSubmission) %>;
        var wasEvaluated = <%- JSON.stringify(!!(existingSubmission && existingSubmission.status === 'EVALUATED')) %>;
        var currentFiles = <%- JSON.stringify((existingSubmission && Array.isArray(existingSubmission.attachments) ? existingSubmission.attachments : []).map(function (a) { return { url: a.url, size: Number(a.size) || 0 }; })) %>;
        var originalUrl = urlInput ? urlInput.value : '';
        var originalNotes = notesInput ? notesInput.value : '';
        var baseHint = hint.textContent;

        function extOf(name) {
          var i = name.lastIndexOf('.');
          return i === -1 ? '' : name.slice(i).toLowerCase();
        }
        function removedUrls() {
          return Array.prototype.slice.call(form.querySelectorAll('.remove-att:checked')).map(function (c) { return c.value; });
        }
        function keptFiles() {
          var gone = removedUrls();
          return currentFiles.filter(function (f) { return gone.indexOf(f.url) === -1; });
        }

        // Client-side validation is instant feedback only — the server
        // (middleware/submissionUpload.js + studentController.submitAssessment)
        // re-validates the extension allow-list, the file count and the combined
        // 5MB limit regardless of what happens here. The limits apply to the files
        // the submission will END UP with (kept + newly added).
        function validateFiles() {
          var added = Array.prototype.slice.call(fileInput.files);
          var kept = keptFiles();
          var total = added.reduce(function (sum, f) { return sum + f.size; }, 0) + kept.reduce(function (sum, f) { return sum + f.size; }, 0);
          var badFile = added.find(function (f) { return ALLOWED_EXTENSIONS.indexOf(extOf(f.name)) === -1; });
          hint.classList.remove('text-amber-600');

          if (badFile) {
            hint.textContent = '"' + badFile.name + '" isn\'t an allowed type.';
            hint.classList.add('text-amber-600');
            fileInput.setCustomValidity('Remove or replace the disallowed file.');
            return;
          }
          if (kept.length + added.length > MAX_FILES) {
            hint.textContent = 'At most ' + MAX_FILES + ' files per submission — remove a current file or add fewer.';
            hint.classList.add('text-amber-600');
            fileInput.setCustomValidity('Too many files.');
            return;
          }
          if (total > MAX_TOTAL_BYTES) {
            hint.textContent = 'Total ' + (total / (1024 * 1024)).toFixed(1) + 'MB — the combined limit is 5MB.';
            hint.classList.add('text-amber-600');
            fileInput.setCustomValidity('Files exceed the 5MB combined limit.');
            return;
          }
          fileInput.setCustomValidity('');
          hint.textContent = added.length
            ? added.length + ' new file(s) selected, ' + (total / (1024 * 1024)).toFixed(2) + 'MB in total with the files you keep.'
            : baseHint;
        }
        fileInput.addEventListener('change', validateFiles);
        form.addEventListener('change', function (e) { if (e.target && e.target.classList && e.target.classList.contains('remove-att')) validateFiles(); });

        form.addEventListener('submit', function (e) {
          if (hasExistingSubmission) {
            var unchanged =
              (urlInput ? urlInput.value : '') === originalUrl &&
              (notesInput ? notesInput.value : '') === originalNotes &&
              !fileInput.files.length && !removedUrls().length;
            if (unchanged) {
              e.preventDefault();
              hint.textContent = 'You haven\'t changed anything, so there is nothing to update.';
              hint.classList.add('text-amber-600');
              return;
            }
            var message = wasEvaluated
              ? 'Updating will send your submission for evaluation again and CLEAR the marks/remarks already given for it. Only the parts you changed are replaced. Continue?'
              : 'Only the parts you changed will be replaced. Continue?';
            if (!confirm(message)) {
              e.preventDefault();
              return;
            }
          }

          // Disable + relabel to prevent a double submit while the
          // (potentially slow, file-upload) request is in flight.
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting…';
        });
      })();
    </script>
  </div>
</div>

<style>
  /* Readable typography for BlockNote-rendered content (renderBlocks.js
     output) — scoped to .prose-content so it only affects assessment/blog
     bodies, not the rest of the app's UI chrome. */
  .prose-content {
    font-size: 0.975rem;
    line-height: 1.75;
    color: var(--color-navy-700, #33415c);
    word-break: break-word;
  }

  .prose-content>*:first-child {
    margin-top: 0;
  }

  .prose-content h1,
  .prose-content h2,
  .prose-content h3,
  .prose-content h4,
  .prose-content h5,
  .prose-content h6 {
    font-weight: 700;
    color: var(--color-navy-900, #0f1729);
    margin-top: 1.5em;
    margin-bottom: 0.5em;
    line-height: 1.3;
  }

  .prose-content h1 {
    font-size: 1.5rem;
  }

  .prose-content h2 {
    font-size: 1.25rem;
  }

  .prose-content h3 {
    font-size: 1.1rem;
  }

  .prose-content p {
    margin: 0 0 1em;
  }

  .prose-content ul,
  .prose-content ol {
    margin: 0 0 1em 1.25rem;
  }

  .prose-content ul {
    list-style: disc;
  }

  .prose-content ol {
    list-style: decimal;
  }

  .prose-content li {
    margin-bottom: 0.4em;
  }

  .prose-content a {
    color: var(--color-info-600, #0284c7);
    text-decoration: underline;
  }

  .prose-content img {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin: 1em auto;
    display: block;
  }

  .prose-content figure {
    margin: 1.25em 0;
  }

  .prose-content figcaption {
    font-size: 0.8rem;
    color: var(--color-navy-400, #94a3b8);
    text-align: center;
    margin-top: 0.4rem;
  }

  .prose-content pre {
    background: var(--color-navy-900, #0f1729);
    color: #e2e8f0;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1em 0;
    font-size: 0.85rem;
  }

  .prose-content pre code {
    background: none;
    padding: 0;
    color: inherit;
  }

  .prose-content :not(pre)>code {
    background: var(--color-navy-50, #f1f4f9);
    padding: 0.15em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.85em;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .prose-content blockquote {
    border-left: 3px solid var(--color-teal, #0f9e8f);
    padding-left: 1rem;
    color: var(--color-navy-500, #64748b);
    margin: 1em 0;
    font-style: italic;
  }

  .prose-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1em 0;
    font-size: 0.875rem;
    display: block;
    overflow-x: auto;
  }

  .prose-content td,
  .prose-content th {
    border: 1px solid var(--color-navy-100, #e2e8f0);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .prose-content hr.rule {
    border: none;
    border-top: 1px solid var(--color-navy-100, #e2e8f0);
    margin: 2rem 0;
  }

  .prose-content details {
    border: 1px solid var(--color-navy-100, #e2e8f0);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    margin: 1em 0;
  }

  .prose-content summary {
    font-weight: 600;
    cursor: pointer;
  }
</style>