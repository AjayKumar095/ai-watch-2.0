<div class="mx-auto mt-4 max-w-xl">
  <div class="card">
    <h1 class="text-xl font-bold text-navy-900"><%= assessment.title %></h1>
    <p class="mt-1 text-sm text-navy-500"><%= assessment.SubjectOffering.SubjectPool.name %> · Max marks <%= assessment.maxMarks %></p>
    <p class="mt-1 text-xs text-navy-400">Window: <%= new Date(assessment.startAt).toLocaleString() %> → <%= new Date(assessment.endAt).toLocaleString() %></p>

    <% if (descriptionHtml) { %>
      <div class="prose-content mt-4 border-t border-navy-100 pt-4"><%- descriptionHtml %></div>
    <% } %>

    <% if (existingSubmission && existingSubmission.status === 'EVALUATED') { %>
      <div class="mt-4 rounded-lg border border-info-200 bg-info-50 px-3 py-2 text-sm text-info-800">
        Evaluated: <%= existingSubmission.marksObtained %>/<%= assessment.maxMarks %>
        <% if (existingSubmission.remarks) { %> — <%= existingSubmission.remarks %><% } %>
      </div>
    <% } %>

    <form action="/student/assessments/<%= assessment.id %>/submit" method="POST" class="mt-6 space-y-4">
      <div>
        <label class="form-label">Submission link (Drive/GitHub/etc.)</label>
        <input class="form-input" name="url" value="<%= existingSubmission ? existingSubmission.url || '' : '' %>" />
      </div>
      <div>
        <label class="form-label">Notes</label>
        <textarea class="form-input" name="description" rows="3"><%= existingSubmission ? existingSubmission.description || '' : '' %></textarea>
      </div>
      <button type="submit" class="btn-primary w-full"><%= existingSubmission ? 'Update submission' : 'Submit' %></button>
    </form>
  </div>
</div>
