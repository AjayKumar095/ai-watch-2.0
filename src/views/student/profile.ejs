<%
  var fullName = (currentUser.firstName + ' ' + currentUser.lastName).trim();
  var initials = ((currentUser.firstName || '').charAt(0) + (currentUser.lastName || '').charAt(0)).toUpperCase();
  var hasSection = !!studentProfile.currentSection;
%>
<style>
  /* Plain CSS for layout so it responds to the real content width (sidebar-safe). */
  .pf-wrap { max-width: 64rem; margin: .5rem auto 0; }
  .pf-layout { display: grid; gap: 1rem; grid-template-columns: minmax(0, 1fr); align-items: start; }
  @media (min-width: 960px) { .pf-layout { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); } }
  .pf-details { display: grid; gap: .25rem 1.5rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 600px) { .pf-details { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 960px) and (max-width: 1180px) { .pf-details { grid-template-columns: minmax(0, 1fr); } }
  .pf-item { display: flex; align-items: flex-start; gap: .75rem; min-width: 0; padding: .65rem 0; border-bottom: 1px solid rgba(148,163,184,.18); }
  .pf-item .pf-ico { flex: 0 0 2rem; }
  .pf-item .pf-txt { min-width: 0; flex: 1; }
  .pf-item dd { overflow-wrap: anywhere; }
  .pf-col { display: grid; gap: 1rem; min-width: 0; }
  /* The shared change-password file is a standalone page (centered, mt-8, max-w-md, its own card);
     inside this page it should just fill its column. */
  .pf-pw > div { margin-top: 0 !important; max-width: none !important; }
  .pf-pw .card { box-shadow: none; padding: 0; border: 0; background: transparent; }
  .pf-hero { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .pf-hero-text { flex: 1 1 14rem; min-width: 0; overflow-wrap: anywhere; }
  .pf-hero-meta { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .5rem; }
  .pf-stats { display: grid; gap: .5rem; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 1rem; }
  @media (max-width: 420px) { .pf-stats { grid-template-columns: minmax(0, 1fr); } }
  .pf-form-row { display: flex; flex-wrap: wrap; gap: .5rem; }
  .pf-form-row select { flex: 1 1 12rem; min-width: 0; width: auto; }
  .pf-form-row button { flex: 0 0 auto; }
  @media (max-width: 420px) { .pf-form-row button { flex: 1 1 100%; } }
</style>

<div class="pf-wrap">

  <!-- Hero -->
  <div class="card">
    <div class="pf-hero">
      <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-navy-100 text-xl font-bold text-navy-700">
        <%= initials || currentUser.firstName.charAt(0).toUpperCase() %>
      </div>
      <div class="pf-hero-text">
        <p class="text-xs font-semibold uppercase tracking-wide text-navy-400">My Profile</p>
        <h1 class="text-2xl font-bold text-navy-900"><%= fullName %></h1>
        <p class="text-sm text-navy-500"><%= currentUser.email %></p>
        <div class="pf-hero-meta">
          <span class="badge-navy"><i class="fa-solid fa-hashtag mr-1"></i>Roll <%= studentProfile.rollNo %></span>
          <% if (studentProfile.Program) { %><span class="badge-info"><i class="fa-solid fa-graduation-cap mr-1"></i><%= studentProfile.Program.name %></span><% } %>
          <% if (hasSection) { %><span class="badge-navy"><i class="fa-solid fa-people-group mr-1"></i>Section <%= studentProfile.currentSection.name %></span><% } %>
        </div>
      </div>
    </div>

    <div class="pf-stats">
      <div class="rounded-lg border border-navy-100 bg-navy-50 px-3 py-2">
        <p class="text-xs text-navy-400">Semester</p>
        <p class="text-lg font-bold text-navy-900"><%= studentProfile.currentSemesterNumber %></p>
      </div>
      <div class="rounded-lg border border-navy-100 bg-navy-50 px-3 py-2">
        <p class="text-xs text-navy-400">Admission year</p>
        <p class="text-lg font-bold text-navy-900"><%= studentProfile.admissionYear %></p>
      </div>
      <div class="rounded-lg border border-navy-100 bg-navy-50 px-3 py-2">
        <p class="text-xs text-navy-400">Section</p>
        <p class="text-lg font-bold text-navy-900"><%= hasSection ? studentProfile.currentSection.name : '—' %></p>
      </div>
    </div>
  </div>

  <div class="pf-layout mt-4">

    <!-- Account -->
    <div class="card">
      <div class="mb-1 flex items-center gap-2">
        <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-sky-50 text-sky-600">
          <i class="fa-solid fa-id-card text-xs"></i>
        </div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-navy-400">Account</h2>
      </div>
      <dl class="pf-details mt-2 text-sm">
        <div class="pf-item">
          <i class="pf-ico fa-solid fa-user mt-1 text-center text-navy-300"></i>
          <div class="pf-txt"><dt class="text-xs text-navy-400">Name</dt><dd class="font-medium text-navy-800"><%= fullName %></dd></div>
        </div>
        <div class="pf-item">
          <i class="pf-ico fa-solid fa-envelope mt-1 text-center text-navy-300"></i>
          <div class="pf-txt"><dt class="text-xs text-navy-400">Email</dt><dd class="font-medium text-navy-800"><%= currentUser.email %></dd></div>
        </div>
        <div class="pf-item">
          <i class="pf-ico fa-solid fa-hashtag mt-1 text-center text-navy-300"></i>
          <div class="pf-txt"><dt class="text-xs text-navy-400">Roll number</dt><dd class="font-medium text-navy-800"><%= studentProfile.rollNo %></dd></div>
        </div>
        <div class="pf-item">
          <i class="pf-ico fa-solid fa-graduation-cap mt-1 text-center text-navy-300"></i>
          <div class="pf-txt"><dt class="text-xs text-navy-400">Program</dt><dd class="font-medium text-navy-800"><%= studentProfile.Program ? studentProfile.Program.name : '—' %></dd></div>
        </div>
        <div class="pf-item">
          <i class="pf-ico fa-solid fa-calendar-days mt-1 text-center text-navy-300"></i>
          <div class="pf-txt"><dt class="text-xs text-navy-400">Admission year</dt><dd class="font-medium text-navy-800"><%= studentProfile.admissionYear %></dd></div>
        </div>
        <div class="pf-item">
          <i class="pf-ico fa-solid fa-layer-group mt-1 text-center text-navy-300"></i>
          <div class="pf-txt"><dt class="text-xs text-navy-400">Semester</dt><dd class="font-medium text-navy-800"><%= studentProfile.currentSemesterNumber %></dd></div>
        </div>
      </dl>
    </div>

    <div class="pf-col">
    <!-- Section -->
    <div class="card">
      <div class="mb-1 flex items-center gap-2">
        <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-violet-50 text-violet-600">
          <i class="fa-solid fa-people-group text-xs"></i>
        </div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-navy-400">Section</h2>
      </div>

      <% if (studentProfile.currentSection) { %>
        <p class="mt-3 text-sm text-navy-700">
          You're in <span class="badge-navy"><%= studentProfile.currentSection.name %></span>.
        </p>
        <p class="mt-2 text-xs text-navy-400">To change sections, ask your teacher or admin — this isn't self-service once set, since it affects your enrollments and assignments.</p>

        <% if (subGroups && subGroups.length) { %>
          <div class="mt-4 border-t border-navy-100 pt-4">
            <h3 class="text-xs font-semibold uppercase tracking-wide text-navy-400">Your Group / PG</h3>
            <p class="mt-1 text-sm text-navy-500">
              Unlike your section, your group is self-service — set it now or change it anytime if you picked the wrong one.
            </p>

            <% if (error) { %>
              <div class="mt-3 flex items-start gap-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
                <i class="fa-solid fa-triangle-exclamation mt-0.5 text-xs"></i>
                <span><%= error %></span>
              </div>
            <% } %>

            <form action="/student/profile/group" method="POST" class="pf-form-row mt-3">
              <select class="form-input" name="subGroupId" aria-label="Group">
                <option value="">None / not applicable</option>
                <% subGroups.forEach(function(g) { %>
                  <option value="<%= g.id %>" <%= studentProfile.currentSectionId === g.id ? 'selected' : '' %>><%= g.name %></option>
                <% }) %>
              </select>
              <button type="submit" class="btn-secondary !px-4 !py-2 text-sm">Save</button>
            </form>
          </div>
        <% } %>
      <% } else { %>
        <p class="mt-3 text-sm text-navy-500">You haven't been placed in a section yet — pick one if it's set up, or check back later.</p>

        <% if (error) { %>
          <div class="mt-3 flex items-start gap-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
            <i class="fa-solid fa-triangle-exclamation mt-0.5 text-xs"></i>
            <span><%= error %></span>
          </div>
        <% } %>

        <% if (!availableSections.length) { %>
          <div class="mt-4 flex flex-col items-center justify-center gap-2 py-8 text-center">
            <div class="flex h-11 w-11 items-center justify-center rounded-full bg-navy-50 text-navy-400">
              <i class="fa-solid fa-clock"></i>
            </div>
            <p class="text-sm text-navy-400">Sections for your program/semester haven't been set up yet. Check back once your teacher or admin has added them.</p>
          </div>
        <% } else { %>
          <form action="/student/profile/section" method="POST" class="mt-4 space-y-4">
            <div>
              <label class="form-label" for="sectionId">Section</label>
              <select class="form-input" id="sectionId" name="sectionId" required>
                <option value="">Select a section</option>
                <% availableSections.forEach(function(s) { %>
                  <option value="<%= s.id %>" data-has-subgroups="<%= s.subGroups && s.subGroups.length ? '1' : '0' %>"><%= s.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="hidden" id="subgroup-wrapper">
              <label class="form-label" for="subGroupId">Sub-group</label>
              <select class="form-input" id="subGroupId" name="subGroupId">
                <option value="">None</option>
              </select>
            </div>
            <button type="submit" class="btn-primary w-full">Save section</button>
          </form>

          <script>
            (function () {
              var sections = <%- JSON.stringify(availableSections) %>;
              var sectionSelect = document.getElementById('sectionId');
              var subGroupSelect = document.getElementById('subGroupId');
              var subGroupWrapper = document.getElementById('subgroup-wrapper');

              sectionSelect.addEventListener('change', function () {
                var chosen = sections.filter(function (s) { return s.id === sectionSelect.value; })[0];
                if (chosen && chosen.subGroups && chosen.subGroups.length) {
                  subGroupSelect.innerHTML = '<option value="">None</option>';
                  chosen.subGroups.forEach(function (g) {
                    var opt = document.createElement('option');
                    opt.value = g.id;
                    opt.textContent = g.name;
                    subGroupSelect.appendChild(opt);
                  });
                  subGroupWrapper.classList.remove('hidden');
                } else {
                  subGroupWrapper.classList.add('hidden');
                }
              });
            })();
          </script>
        <% } %>
      <% } %>
    </div>

    <!-- Security: the shared change-password form, included as-is -->
    <div class="card pf-pw">
      <div class="mb-2 flex items-center gap-2">
        <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-amber-50 text-amber-600">
          <i class="fa-solid fa-key text-xs"></i>
        </div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-navy-400">Security</h2>
      </div>
      <%- include('../account/change-password', { success: false, error: null }) %>
    </div>
    </div><!-- /pf-col -->
  </div>
</div>

<script>
  // Change the password without leaving this page: the shared form posts to /account/change-password,
  // which replies with its own standalone page. Send the same POST in the background, read the reply
  // for the success / error message, and show it here (auto-hides after 2 seconds).
  (function () {
    var form = document.querySelector('.pf-pw form[action="/account/change-password"]');
    if (!form) return;
    var pw = document.getElementById('currentPassword');

    // The shared form has `autofocus`, which would scroll this page down and pop the keyboard on phones.
    if (pw) {
      pw.removeAttribute('autofocus');
      var touched = false, tries = 0;
      ['pointerdown', 'keydown', 'touchstart'].forEach(function (ev) {
        document.addEventListener(ev, function () { touched = true; }, { once: true, capture: true });
      });
      var focusTimer = setInterval(function () {
        if (touched || ++tries > 20) return clearInterval(focusTimer);
        if (document.activeElement === pw) {
          pw.blur();
          var main = document.querySelector('main');
          if (main) main.scrollTop = 0;
          window.scrollTo(0, 0);
        }
      }, 50);
    }

    var note = document.createElement('div');
    note.setAttribute('role', 'status');
    note.style.display = 'none';
    form.parentNode.insertBefore(note, form);
    var hideTimer = null;
    function show(kind, text) {
      var good = kind === 'ok';
      clearTimeout(hideTimer);
      hideTimer = setTimeout(function () { note.style.display = 'none'; }, 2000);
      note.className = 'mt-4 rounded-lg border px-3 py-2 text-sm ' + (good ? 'border-green-200 bg-green-50 text-green-800' : 'border-amber-200 bg-amber-50 text-amber-800');
      note.textContent = text;
      note.style.display = '';
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var f = form.elements;
      if (f.newPassword.value !== f.confirmPassword.value) return show('err', 'New password and confirmation do not match.');
      var btn = form.querySelector('button[type=submit]');
      var label = btn.textContent;
      btn.disabled = true; btn.textContent = 'Updating…';
      note.style.display = 'none';
      fetch(form.getAttribute('action'), {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(new FormData(form)).toString()
      })
        .then(function (r) {
          if (r.redirected && /\/login/.test(r.url)) { window.location.href = r.url; return null; }
          return r.text();
        })
        .then(function (html) {
          if (html === null) return;
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var ok = doc.querySelector('.border-green-200');
          var bad = doc.querySelector('main .border-amber-200, .border-amber-200');
          if (ok) { form.reset(); show('ok', 'Your password has been updated.'); }
          else if (bad) show('err', bad.textContent.trim());
          else show('err', 'Could not confirm the change. Please try again.');
        })
        .catch(function () { show('err', 'Something went wrong. Please try again.'); })
        .then(function () { btn.disabled = false; btn.textContent = label; });
    });
  })();
</script>
