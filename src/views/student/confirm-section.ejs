<div class="mx-auto mt-2 max-w-xl">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-navy-900">Welcome, <%= currentUser.firstName %></h1>
    <p class="mt-1 text-sm text-navy-500">Before you continue, take a second to confirm your section details below.</p>
  </div>

  <!-- Their info, read-only -->
  <div class="card">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-navy-400">Your Details</h2>
    <dl class="mt-3 space-y-2 text-sm">
      <div class="flex justify-between"><dt class="text-navy-500">Roll number</dt><dd class="font-medium text-navy-800"><%= studentProfile.rollNo %></dd></div>
      <div class="flex justify-between"><dt class="text-navy-500">Program</dt><dd class="font-medium text-navy-800"><%= studentProfile.Program ? studentProfile.Program.name : '—' %></dd></div>
      <div class="flex justify-between"><dt class="text-navy-500">Admission year</dt><dd class="font-medium text-navy-800"><%= studentProfile.admissionYear %></dd></div>
      <div class="flex justify-between"><dt class="text-navy-500">Semester</dt><dd class="font-medium text-navy-800"><%= studentProfile.currentSemesterNumber %></dd></div>
      <div class="flex justify-between"><dt class="text-navy-500">Section</dt><dd class="font-medium text-navy-800"><%= studentProfile.currentSection.name %></dd></div>
    </dl>
  </div>

  <!-- Optional PG/group selection -->
  <div class="card mt-4">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-navy-400">Your Group / PG</h2>
    <p class="mt-2 text-sm text-navy-500">
      Section <strong><%= studentProfile.currentSection.name %></strong> is split into a few groups. If you know which one you belong to, pick it below — otherwise it's fine to skip this and continue.
    </p>

    <% if (error) { %>
      <div class="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= error %></div>
    <% } %>

    <form action="/student/confirm-section" method="POST" class="mt-4 space-y-2">
      <label class="flex items-center gap-3 rounded-lg border border-navy-100 px-3 py-2 text-sm hover:bg-navy-50">
        <input type="radio" name="subGroupId" value="" checked>
        <span>
          <span class="block font-medium text-navy-800">I'm not sure / doesn't apply</span>
          <span class="text-xs text-navy-400">Skip for now — you can always confirm this later with your mentor.</span>
        </span>
      </label>

      <% subGroups.forEach(function(g) { %>
        <label class="flex items-center gap-3 rounded-lg border border-navy-100 px-3 py-2 text-sm hover:bg-navy-50">
          <input type="radio" name="subGroupId" value="<%= g.id %>">
          <span class="font-medium text-navy-800"><%= g.name %></span>
        </label>
      <% }) %>

      <button type="submit" class="btn-primary w-full mt-4">Continue to Dashboard</button>
    </form>
  </div>

  <!-- Contact / correction note -->
  <div class="mt-4 rounded-lg border border-info-200 bg-info-50 px-3 py-2 text-sm text-info-800">
    <strong>Something above look wrong?</strong>
    <% if (mentor) { %>
      This group list is only for the PG split — if your program, section, semester, or any other detail is incorrect, please contact your mentor,
      <strong><%= mentor.name %></strong> (<a href="mailto:<%= mentor.email %>" class="underline"><%= mentor.email %></a>), to get it corrected.
    <% } else { %>
      This group list is only for the PG split — if your program, section, semester, or any other detail is incorrect, please contact your school admin to get it corrected.
    <% } %>
  </div>
</div>
