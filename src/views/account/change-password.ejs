<div class="mx-auto mt-8 max-w-md">
  <div class="card">
    <h1 class="text-xl font-bold text-navy-900">Change password</h1>
    <p class="mt-1 text-sm text-navy-500">If you're using a temporary password, set a new one now.</p>

    <% if (success) { %>
      <div class="mt-4 rounded-lg border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800">
        Your password has been updated.
      </div>
    <% } %>
    <% if (error) { %>
      <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= error %></div>
    <% } %>

    <form action="/account/change-password" method="POST" class="mt-6 space-y-4">
      <div>
        <label class="form-label" for="currentPassword">Current password</label>
        <input class="form-input" type="password" id="currentPassword" name="currentPassword" required autofocus />
      </div>
      <div>
        <label class="form-label" for="newPassword">New password</label>
        <input class="form-input" type="password" id="newPassword" name="newPassword" minlength="8" required />
      </div>
      <div>
        <label class="form-label" for="confirmPassword">Confirm new password</label>
        <input class="form-input" type="password" id="confirmPassword" name="confirmPassword" minlength="8" required />
      </div>
      <button type="submit" class="btn-primary w-full">Update password</button>
    </form>
  </div>
</div>
